---
import ArtworkImage from '../../components/ArtworkImage.astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {getProjects} from '../../data/content';
import {projectArtwork} from '../../data/visuals';
import {stageLabel} from '../../data/projects';
const projects = (await getProjects()).filter(project => project.category === 'Mobility');
const roles: Record<string, {verb:string; question:string; bridge:string}> = {
  'nrth-tms': {verb:'Plan the work.', question:'What needs to move, and who is responsible?', bridge:'A transport request becomes a route, a resource decision, and a clear next handoff.'},
  'nrth-telematics': {verb:'Read the movement.', question:'What does the vehicle information actually tell us?', bridge:'Location and activity need timestamps, source context, and a decision they can inform.'},
  'nrth-logistics': {verb:'Connect the handoffs.', question:'How do the parts of a wider journey fit together?', bridge:'Requirements, partners, and ownership keep the process understandable between organizations.'},
  'nrth-fleet': {verb:'Understand the resources.', question:'Which vehicles and responsibilities support the work?', bridge:'Readiness and capacity shape an assignment before it enters a transport plan.'},
};
---
<Layout title='Mobility' description='Understand the distinct roles of NRTH TMS, Telematics, Logistics, and Fleet. Explore transportation planning, vehicle context, handoffs, and resources.'>
  <section class='page-intro'><span class='eyebrow'>NRTH / Mobility / Four perspectives</span><h1>Movement is<br />a shared effort.</h1><p>One journey involves planning, vehicle context, handoffs, and resources. Our four Mobility ventures give each of those questions its own focus.</p><a class='text-link' href='/projects/nrth-tms#interactive-concept'>Try the planning concept <Icon /></a></section>
  <section class='section mobility-overview'><div class='mobility-track' aria-label='Four roles in connected movement'>{projects.map((project, i) => <a href={'#' + project.slug}><span class='ring-bullet'></span><span class='eyebrow'>0{i+1} / {project.name.replace('NRTH ', '')}</span><strong>{roles[project.slug].verb}</strong><Icon /></a>)}</div><p class='availability-note'>These are complementary venture directions. A confirmed product integration or service arrangement is established directly with NRTH.</p></section>
  <section class='section mobility-roles'>{projects.map(project => {const visual = projectArtwork(project.slug, project), role = roles[project.slug]; return <article id={project.slug} class='mobility-role' data-reveal><div class='mobility-role-image'><ArtworkImage src={visual.src} width={900} height={typeof visual.src === 'string' ? 600 : Math.round(900 * visual.src.height / visual.src.width)} widths={[400,700,900]} sizes='(max-width:767px) 90vw, 44vw' alt={visual.alt} format='webp' loading='lazy' /></div><div><span class='eyebrow'>{project.name}</span><h2>{role.verb}</h2><p class='lead-copy'>{role.question}</p><p>{role.bridge}</p><span class='stage-badge'>{stageLabel(project)}</span><a class='text-link' href={'/projects/' + project.slug}>Explore {project.name} <Icon /></a></div></article>;})}</section>
  <section class='section discussion-section'><div data-reveal><span class='eyebrow'>Start with the decision</span><h2>Find the right<br />conversation.</h2></div><div data-reveal><p class='lead-copy'>Tell us which part of the journey needs attention.</p><p>A dispatch question points toward TMS. A source or signal question points toward Telematics. A handoff between partners points toward Logistics. A vehicle or capacity question points toward Fleet.</p><a class='text-link' href='/contact?project=nrth-tms'>Discuss your Mobility context <Icon /></a><a class='text-link' href='/insights/connecting-the-parts-of-movement'>Read the Mobility perspective <Icon /></a></div></section>
</Layout>
