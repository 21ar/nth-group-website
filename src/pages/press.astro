---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import CompanyNav from '../components/CompanyNav.astro';
---
<Layout title='Press & brand resources' description='NRTH company information, portfolio overview, and the canonical NRTH wordmark for editorial reference.'>
  <CompanyNav />
  <section class='page-intro'><span class='eyebrow'>NRTH Inc. / Press & resources</span><h1>The name.<br />The perspective.</h1><p>Company information and identity resources for a clear, consistent introduction to NRTH.</p></section>
  <section class='section press-resources'><div class='brand-resource' data-reveal><Logo footer /><p>The NRTH wordmark. Preserve its proportions and the shape of every letter.</p><a class='text-link' href='/resources/nrth-wordmark.svg' download>Download SVG wordmark <Icon name='down' /></a><a class='text-link' href='/resources/nrth-wordmark-outline.svg' download>Download outline version <Icon name='down' /></a></div><div data-reveal><span class='eyebrow'>Company introduction</span><h2>NRTH Inc.</h2><p class='lead-copy'>NRTH Inc. brings together nine venture directions across health, mobility, systems, materials, events, and research.</p><p>The portfolio comprises NRTH Health, NRTH TMS, NRTH Telematics, NRTH Logistics, NRTH Systems, NRTH Labs, NRTH Chemicals, NRTH Fleet, and NRTH Events. Each has a distinct focus within a shared company identity.</p><p>NRTH is the company and portfolio name. nrth.group is its website domain. Product scope, availability, and commercial details are confirmed with the company.</p><a class='text-link' href='/resources/nrth-company-overview.pdf' download>Download company overview <Icon name='down' /></a><a class='text-link' href='/contact'>Request information or imagery <Icon /></a></div></section>
</Layout>
