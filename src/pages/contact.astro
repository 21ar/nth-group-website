---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@nrth.group';
const investorsEmail = import.meta.env.PUBLIC_INVESTORS_EMAIL || 'investors@nrth.group';
const partnershipsEmail = import.meta.env.PUBLIC_PARTNERSHIPS_EMAIL || 'partnerships@nrth.group';
---
<Layout title="Contact" description="Start a conversation with NRTH about a project, a partnership, or a new possibility.">
  <section class="page-intro contact-intro"><span class="eyebrow">Contact NRTH</span><h1>A conversation.<br />A new possibility.</h1><p>A project you’re curious about. An idea worth exploring. Tell us a little about it.</p></section>
  <section class="section contact-form-section">
    <div class="contact-side"><span class="eyebrow">Let’s find the right connection</span><p>Choose a project or start with a general inquiry. Prepare your message below, then review it before sharing.</p><div class="contact-addresses"><span class="eyebrow">General & project inquiries</span><a class="text-link" href={`mailto:${email}`}>{email} <Icon name="upRight" /></a><span class="eyebrow">Partnerships</span><a class="text-link" href={`mailto:${partnershipsEmail}`}>{partnershipsEmail} <Icon name="upRight" /></a><span class="eyebrow">Investors</span><a class="text-link" href={`mailto:${investorsEmail}`}>{investorsEmail} <Icon name="upRight" /></a></div></div>
    <form class="contact-form" data-inquiry-form data-contact-email={email} data-partnerships-email={partnershipsEmail} data-investors-email={investorsEmail}>
      <div class="form-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="First and last name" /></div>
      <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></div>
      <div class="form-field"><label for="organization">Organization <span>(optional)</span></label><input id="organization" name="organization" autocomplete="organization" maxlength="180" placeholder="Your company or team" /></div>
      <div class="form-field"><label for="project">What brings you here?</label><select id="project" name="project"><option value="general">General inquiry</option>{projects.map(project => <option value={project.slug}>{project.name}</option>)}<option value="partnership">Partnership</option><option value="investor">Investor inquiry</option></select></div>
      <div class="form-field form-wide"><label for="message">Your message</label><textarea id="message" name="message" required minlength="10" maxlength="5000" placeholder="What would you like to explore together?"></textarea></div>
      <p class="form-note form-wide">Your message stays in your browser until you choose to share it. Please don’t include medical records or other sensitive information. <a href="/privacy">Privacy information</a>.</p>
      <button class="form-submit form-wide" type="submit">Prepare inquiry <Icon /></button>
      <noscript><p class="form-note form-wide">Enable JavaScript to prepare an inquiry here.{email && <a href={`mailto:${email}`}> You can also email NRTH directly.</a>}</p></noscript>
      <div class="inquiry-result" data-inquiry-result hidden tabindex="-1">
        <h3>Your inquiry, ready to review.</h3><p>Open your email app to send this message, or save a copy. Nothing has been sent yet.</p>
        <pre class="inquiry-preview" data-inquiry-preview></pre>
        <div class="inquiry-actions"><a data-inquiry-email hidden>Open email app</a><button type="button" data-inquiry-copy>Copy inquiry</button><a data-inquiry-download download="nrth-inquiry.txt">Save a copy</a><button type="button" data-inquiry-edit>Edit message</button></div>
        <p class="inquiry-status" data-inquiry-status role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>
</Layout>
