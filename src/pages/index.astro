---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { siteContent } from '../data/site-content';
import KineticHero from '../components/KineticHero.astro';
import Icon from '../components/Icon.astro';
import EcosystemPaths from '../components/EcosystemPaths.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import { articles } from '../data/articles';
import connectionArt from '../assets/connection-art.png';
import { artwork } from '../data/visuals';
const fields = [{ name: 'Health', count: '01' }, { name: 'Mobility', count: '04' }, { name: 'Technology', count: '02' }, { name: 'Industry', count: '01' }, { name: 'Experiences', count: '01' }];
const articleArtwork = [artwork.health, artwork.mobility, artwork.labs];
---
<Layout description="Discover NRTH: a connected ecosystem of projects across health, transportation, telematics, logistics, systems, research, chemicals, fleet, and events.">
  <KineticHero />
  <div class="field-strip" aria-label="Our fields">{fields.map(field => <a href={`/projects?field=${field.name}`}><span>{field.name}</span><sup>{field.count}</sup><Icon name="upRight" /></a>)}</div>
  <section id="ecosystem" class="section showcase-section">
    <div class="showcase-heading" data-reveal><div><span class="eyebrow">01 / The ecosystem</span><h2>Different fields.<br />Shared ambition.</h2></div><div><p>Not every idea belongs in the same box. Meet nine perspectives on a more connected world.</p><span class="eyebrow">Health · Mobility · Technology · Industry · Experiences</span></div></div>
    <div data-reveal><ProjectExplorer /></div>
  </section>
  <section class="connection-art-section" aria-labelledby="connection-art-heading" data-scroll-feature>
    <div class="connection-art-copy" data-reveal><span class="eyebrow">One thread. Many possibilities.</span><h2 id="connection-art-heading">The value is<br />in the connection.</h2><p>Across our ventures, we begin with the same question: how can the parts work better together?</p><a class="text-link" href="/approach" data-magnetic>Our approach <Icon /></a></div>
    <div class="connection-art-image" data-reveal><Image src={connectionArt} width={1600} widths={[600,1000,1600]} sizes="(max-width:767px) 100vw, 65vw" alt="Three fluid platinum strands joined in an infinity sculpture, illustrating NRTH’s shared perspective" format="webp" quality={82} loading="lazy" /></div>
  </section>
  <EcosystemPaths />
  <section class="section connection-section">
    <div class="connection-heading" data-reveal><span class="eyebrow">02 / A shared perspective</span><h2>Good things happen<br />between disciplines.</h2><a class="text-link" href="/about">The thinking behind NRTH <Icon /></a></div>
    <div class="principles" data-reveal>
      <details open><summary><span>01</span><h3>People. Then technology.</h3><Icon name="upRight" /></summary><p>Start with a real need. The person navigating care, the team coordinating a shipment, the organization making a complex decision. The work becomes clearer when the people come first.</p></details>
      <details><summary><span>02</span><h3>Make the connections useful.</h3><Icon name="upRight" /></summary><p>Separate products can share a perspective. TMS connects planning. Telematics adds context. Fleet connects resources. Their differences matter as much as the connections between them.</p></details>
      <details><summary><span>03</span><h3>Leave room to go further.</h3><Icon name="upRight" /></summary><p>Build with enough focus to move an idea forward and enough curiosity to question it. NRTH Labs gives early questions a place to become experiments, prototypes, and new possibilities.</p></details>
    </div>
  </section>
  <section class="lab-feature" data-scroll-feature aria-labelledby="labs-heading">
    <div class="lab-visual" data-reveal><Image src={artwork.labs.src} width={1200} widths={[600, 900, 1200]} sizes="(max-width: 767px) 100vw, 50vw" alt={artwork.labs.alt} format="webp" quality={82} loading="lazy" /><span class="eyebrow">NRTH Labs / The next perspective</span></div>
    <div class="lab-copy"><span class="eyebrow" data-reveal>03 / A place for possibility</span><h2 id="labs-heading" data-reveal>What if<br />is a good start.</h2><p data-reveal>Some ideas don’t come with a category. Labs is where questions get space, experiments take shape, and new connections begin.</p><div class="lab-topics" data-reveal><span>Research</span><span>Prototypes</span><span>New ventures</span></div><a class="text-link" href="/projects/nrth-labs" data-reveal>Step into NRTH Labs <Icon /></a></div>
  </section>
  <section class="section editorial-section">
    <div class="editorial-heading" data-reveal><div><span class="eyebrow">04 / The journal</span><h2>Notes on<br />moving forward.</h2></div><a class="text-link" href="/insights">All perspectives <Icon /></a></div>
    <div class="editorial-grid">{articles.map((article, i) => <a class="editorial-card" href={`/insights/${article.slug}`} data-reveal><div class="editorial-image"><Image src={articleArtwork[i].src} width={700} widths={[400, 700]} sizes="(max-width: 767px) 90vw, 30vw" alt={articleArtwork[i].alt} format="webp" loading="lazy" /><span><Icon name="upRight" /></span></div><div class="editorial-meta"><span class="eyebrow">{article.category}</span><span>3 min read</span></div><h3>{article.title}</h3><p>{article.description}</p></a>)}</div>
  </section>
  <section class="section investor-home"><div data-reveal><span class="eyebrow">{siteContent.investors.label}</span><h2>{siteContent.investors.lines[0]}<br />{siteContent.investors.lines[1]}</h2></div><div data-reveal><p>{siteContent.investors.copy}</p><a class="text-link" href="/investors">{siteContent.investors.link} <Icon /></a></div></section>
  <section class="section contact-section contact-invitation"><div><span class="eyebrow" data-reveal>05 / The next connection</span><a href="/contact" class="contact-heading" data-reveal>Have a thought?<br />Let’s take it further. <Icon name="upRight" /></a></div><p data-reveal>A new project. A partnership.<br />A question worth asking.<br /><a href="/contact">Start a conversation <Icon /></a></p></section>
</Layout>
