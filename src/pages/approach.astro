---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import EcosystemPaths from '../components/EcosystemPaths.astro';
const stages = [
  {title:'Understand the real work.',label:'Discover',text:'Begin with the people, their decisions, and the constraints around the work. Explore what happens today before deciding what should change.',items:['Map the current workflow and its handoffs','Identify users, owners, and practical constraints','Define the question and an initial measure of success'],output:'A shared problem statement and a useful first scope.'},
  {title:'Make the question tangible.',label:'Explore',text:'Use a focused investigation, prototype, or working conversation to examine the assumptions that matter most. Match the method to the uncertainty.',items:['Choose the assumption worth testing first','Consider different operational and technical perspectives','Review the evidence and record what remains open'],output:'A tested direction, or a clearer reason to choose another one.'},
  {title:'Connect the details.',label:'Shape',text:'Bring the experience, information, and technical requirements into one considered plan. Clear boundaries help a project stay useful as it develops.',items:['Define roles, states, and important next actions','Consider access, reliability, and integration needs','Agree on responsibilities and the proposed next stage'],output:'A practical proposal with clear decisions and ownership.'},
  {title:'Keep learning from use.',label:'Refine',text:'A useful direction should continue to be questioned. Review what people understand, where work stalls, and which details deserve the next investment.',items:['Review the workflow against the original question','Identify confusing handoffs and missing context','Prioritize improvements by their practical value'],output:'A considered next step grounded in the work.'},
];
const collaborations = [
  {title:'Explore a project',text:'You have an operational question, a product idea, or a workflow that could be clearer.',details:'Tell us who is involved, how the work happens today, and what you want to understand or improve.',link:'/contact'},
  {title:'Discuss a partnership',text:'You see a connection between your organization and a NRTH venture.',details:'Introduce your organization, the perspective you bring, and a specific opportunity to explore together.',link:'/contact?project=partnership'},
  {title:'Bring a research question',text:'A useful assumption needs investigation before a bigger commitment.',details:'Describe the uncertainty, what is already known, and how an answer would affect the next decision.',link:'/contact?project=nrth-labs'},
];
---
<Layout title="Our approach" description="Explore how NRTH approaches discovery, research, practical systems, and cross-field collaboration across its nine ventures.">
  <section class="page-intro"><span class="eyebrow">Our approach / From question to direction</span><h1>Start with a question.<br />Make the next step useful.</h1><p>A considered way to explore ideas, understand real work, and connect the details that help a project move forward.</p></section>
  <section class="section approach-stages"><div class="editorial-heading"><div><span class="eyebrow">A framework for the conversation</span><h2>Curiosity,<br />with a direction.</h2></div><p>Every project has different needs. This framework describes our perspective on the work, rather than a fixed service package or delivery commitment.</p></div>{stages.map((stage,i) => <article class="approach-stage" data-reveal><div><span class="journey-number">0{i+1}</span><span class="eyebrow">{stage.label}</span></div><div><h3>{stage.title}</h3><p>{stage.text}</p><ul>{stage.items.map(item=><li>{item}</li>)}</ul><p class="stage-output"><span class="eyebrow">A useful outcome</span>{stage.output}</p></div></article>)}</section>
  <EcosystemPaths />
  <section class="section collaboration-section"><div class="editorial-heading" data-reveal><div><span class="eyebrow">Ways to work together</span><h2>Different starting points.<br />A shared conversation.</h2></div></div><div class="capability-grid">{collaborations.map((item,i)=><article data-reveal><span class="eyebrow">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p><p>{item.details}</p><a class="text-link" href={item.link}>Start here <Icon name="upRight" /></a></article>)}</div></section>
  <section class="section venture-faq"><div><span class="eyebrow">Before we begin</span><h2>A few useful<br />details.</h2></div><div class="principles"><details><summary><h3>Do we need a finished brief?</h3><Icon name="plus" /></summary><p>No. A short description of the question, the people involved, and your existing context is a useful starting point. The first conversation can help clarify the scope.</p></details><details><summary><h3>Can a conversation involve several ventures?</h3><Icon name="plus" /></summary><p>Yes. If your question spans transportation, fleet, systems, or another field, describe the whole context. We can discuss the relevant perspectives without assuming that all offerings or integrations are available.</p></details><details><summary><h3>How are timing and scope established?</h3><Icon name="plus" /></summary><p>Timing, deliverables, commercial terms, and responsibilities depend on the specific opportunity. This website introduces directions and a working perspective; commitments belong in a scoped discussion.</p></details></div></section>
  <section class="section contact-section"><span class="eyebrow">Your next question</span><a href="/contact" class="contact-heading" data-reveal>What are you<br />working on? <Icon name="upRight" /></a></section>
</Layout>
