---
import Layout from '../../layouts/Layout.astro';
import {getArticles} from '../../data/content';
import {Image} from 'astro:assets';
import {artwork} from '../../data/visuals';
import ContactInvitation from '../../components/ContactInvitation.astro';
const articles=await getArticles();
const visuals=[artwork.health,artwork.mobility,artwork.labs];
---
<Layout title='Journal' description='New perspectives from NRTH on attention, movement and experimentation. Read the questions behind the venture directions.'>
 <section class='page-heading'><span class='section-label'>The journal</span><h1>Think out loud.<br/><em>Look a little deeper.</em></h1><p>Notes from the spaces between industries, information and the people doing the work.</p></section>
 <section class='page-body'><div class='journal-grid'>{articles.map((article,i)=><a href={'/insights/'+article.slug} data-enter><Image src={visuals[i%visuals.length].src} widths={[480,800]} sizes='(max-width:767px) 88vw, 30vw' alt={visuals[i%visuals.length].alt} format='webp' loading='lazy'/><span class='section-label'>{article.category}</span><h3>{article.title}</h3><p>{article.description}</p></a>)}</div></section>
 <ContactInvitation/>
</Layout>
