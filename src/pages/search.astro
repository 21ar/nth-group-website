---
import Layout from '../layouts/Layout.astro';
import {getSearchRecords} from '../data/search';
import {searchTypes,searchTypeLabels} from '../data/search-engine';
import '../styles/discovery-search.css';
const records=await getSearchRecords();
---
<Layout title='Search NRTH' description='Find NRTH ventures, industry perspectives, writing, research and public resources.'>
 <section class='page-heading'><span class='section-label'>Discover NRTH</span><h1>Find your<br/><em>perspective.</em></h1><p>Follow a question into a venture, an industry, a piece of thinking or a practical resource.</p></section>
 <section class='search-page-body'><div class='search-interface' data-public-search data-search-page>
  <label for='directory-search-input' data-search-enhanced hidden>Search the public website</label><input id='directory-search-input' type='search' maxlength='120' placeholder='Try transport, materials or research' autocomplete='off' data-public-search-input data-search-enhanced hidden/>
  <div class='search-type-filters' role='group' aria-label='Search within' data-search-enhanced hidden>{searchTypes.map(type=><button type='button' data-search-type={type} aria-pressed={type==='all'}>{searchTypeLabels[type]}</button>)}</div>
  <p class='search-result-status' role='status' aria-live='polite' data-public-search-status>Browse the public directory below, or use your browser’s Find tool.</p>
  <ul class='search-results' data-public-search-results></ul>
  <p class='search-footnote' data-search-enhanced hidden>Search stays in your browser. No inquiry details or private previews are included.</p>
 </div>
 <details class='search-directory' open data-search-directory><summary>Browse the public directory</summary><div>{searchTypes.filter(type=>type!=='all').map(type=><section><h2>{searchTypeLabels[type]}</h2><ul>{records.filter(record=>record.type===type).map(record=><li><a href={record.url}>{record.title}</a><p>{record.description}</p></li>)}</ul></section>)}</div></details>
 </section>
</Layout>
