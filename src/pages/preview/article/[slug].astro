---
import ArticlePage from '../../../components/ArticlePage.astro';
import {getArticles} from '../../../data/content';
import {cookieName,validPreviewSession,privatePreviewRedirect} from '../../../server/preview';
export const prerender = false;
Astro.response.headers.set('Cache-Control','private, no-store');
if (!validPreviewSession(Astro.cookies.get(cookieName)?.value)) return privatePreviewRedirect();
const article = (await getArticles(true)).find(item => item.slug === Astro.params.slug);
if (!article) return privatePreviewRedirect('/404');
---
<ArticlePage article={article} draft />
<script>import '../../../scripts/preview';</script>
