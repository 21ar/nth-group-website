---
import IndustryPage from '../../../components/IndustryPage.astro';
import {getIndustries} from '../../../data/content';
import {cookieName,validPreviewSession,privatePreviewRedirect} from '../../../server/preview';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
if(!validPreviewSession(Astro.cookies.get(cookieName)?.value))return privatePreviewRedirect();
const industry=(await getIndustries(true)).find(item=>item.name.toLowerCase()===Astro.params.slug);
if(!industry)return privatePreviewRedirect('/404');
---
<IndustryPage slug={industry.name.toLowerCase()} draft/>
<script>import '../../../scripts/preview';</script>
