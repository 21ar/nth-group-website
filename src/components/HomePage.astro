---
import Layout from '../layouts/Layout.astro';
import {Image} from 'astro:assets';
import MatterStory from './MatterStory.astro';
import VentureIndex from './VentureIndex.astro';
import ContactInvitation from './ContactInvitation.astro';
import ConnectionsExplorer from './ConnectionsExplorer.astro';
import IndustryDirectory from './IndustryDirectory.astro';
import VentureSpotlight from './VentureSpotlight.astro';
import architecture from '../assets/matterfield/matter-architecture.png';
import research from '../assets/matterfield/matter-research.png';
import {getArticles} from '../data/content';
interface Props {draft?:boolean;}
const {draft=false}=Astro.props;
const articles=await getArticles(draft);
---
<Layout noindex={draft} description='NRTH Inc. is an independent company with nine venture directions across mobility, health, systems, materials, events and research. Build beyond.'>
 {draft&&<aside class='preview-banner'><a href='/preview'>Editorial workspace</a><span data-preview-status>Draft preview</span></aside>}
 <MatterStory draft={draft}/>
 <section class='portfolio-section' id='ventures'><div class='section-heading' data-enter><h2>Pick a<br/><em>possibility.</em></h2><p>Nine ventures. Different ambitions.<br/>Find the question that speaks to you.</p></div><VentureIndex draft={draft}/></section>
 <section class='manifesto-section'><div class='manifesto-statement' data-enter><span class='section-label'>The company</span><h2>We see potential<br/>in the spaces<br/><em>between.</em></h2></div><div class='manifesto-image' data-image-reveal><Image src={architecture} alt='Conceptual graphite architecture with a warm orange aperture' widths={[640,1100,1600]} sizes='(max-width:767px) 100vw, 62vw' format='webp' loading='lazy'/></div><div class='manifesto-copy' data-enter><p>Health and software. Movement and information. Materials and new applications. The world does not divide itself neatly into categories.</p><p>NRTH gives distinct ventures room to develop, and creates space for ideas to travel between them.</p><a class='inline-link' href='/about'>Meet the company</a></div></section>
 <ConnectionsExplorer/>
 <VentureSpotlight/>
 <IndustryDirectory draft={draft}/>
 <section class='research-spread'><div data-image-reveal><Image src={research} alt='Conceptual crystalline silver structure emerging from dark stone' widths={[600,1000,1600]} sizes='(max-width:767px) 100vw, 57vw' format='webp' loading='lazy'/></div><div class='research-spread-copy' data-enter><span class='section-label'>NRTH Labs</span><h2>The interesting<br/>part is<br/><em>what if.</em></h2><p>Questions create room to move. Our research direction turns assumptions into something that can be examined, challenged and developed.</p><a class='inline-link' href='/research'>Enter the research</a></div></section>
 <section class='journal-section'><div class='section-heading' data-enter><h2>Thinking<br/>out loud.</h2><a class='inline-link' href='/insights'>The journal</a></div><div class='journal-grid'>{articles.slice(0,3).map(article=><a href={'/insights/'+article.slug} data-enter><span class='section-label'>{article.category}</span><h3>{article.title}</h3><p>{article.description}</p></a>)}</div></section>
 <section class='investor-bridge' data-enter><span class='section-label'>Investors</span><h2>A wider lens.<br/>A longer view.</h2><div><p>Start with the company and the questions behind its portfolio. Then examine the particular venture, its stage and the next practical step.</p><a class='inline-link' href='/investors'>Investor conversations</a></div></section>
 <ContactInvitation/>
</Layout>
