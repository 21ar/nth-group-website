---
import {Image} from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import {getArticles, getSiteContent} from '../data/content';
import {getIndustries} from '../data/content';
import {artwork} from '../data/visuals';
import KineticHero from '../components/KineticHero.astro';
import Icon from '../components/Icon.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import VentureDemo from '../components/VentureDemo.astro';
interface Props {draft?: boolean;}
const {draft = false} = Astro.props;
const articles = await getArticles(draft);
const siteContent = await getSiteContent(draft);
const articleArtwork = [artwork.systems, artwork.mobility, artwork.labs];

const industries = await getIndustries(draft);
---
<Layout noindex={draft} description='NRTH Inc. brings together nine ventures across health, mobility, systems, materials, events, and research. Explore our portfolio and interactive concepts.'>
  {draft && <aside class='preview-banner'><a href='/preview'>← Editorial workspace</a><span data-preview-status>Draft preview</span></aside>}
  <KineticHero draft={draft} />
  <section id='ecosystem' class='section showcase-section portfolio-bridge'>
    <div class='showcase-heading' data-reveal><div><span class='eyebrow'>01 / The ventures</span><h2>Find your<br />next perspective.</h2></div><div><p>Nine ventures, each with a distinct question. Explore the people, workflows, and possibilities behind the name.</p><a class='text-link' href='/industries/mobility'>Explore the Mobility ecosystem <Icon /></a></div></div>
    <div class='field-strip' aria-label='Explore by field'>{industries.map(field => <a href={'/projects?field=' + field.name}><span>{field.name}</span><sup>{String(field.ventures.length).padStart(2, '0')}</sup><Icon name='upRight' /></a>)}</div>
    <div data-reveal><ProjectExplorer draft={draft} /></div>
  </section>
  <section class='section proof-section' aria-labelledby='dispatch-heading'>
    <div class='proof-intro' data-reveal><div><span class='eyebrow'>02 / An idea you can try</span><h2 id='dispatch-heading'>Less abstraction.<br />More understanding.</h2></div><div><p>Choose a route, match a vehicle, and inspect the handoff. A working concept makes the thinking behind NRTH TMS tangible.</p><span class='eyebrow'>Transportation / Interactive concept</span></div></div>
    <div data-reveal><VentureDemo slug='nrth-tms' /></div>
    <div class='proof-footer'><p>Concept interface with sample data. Product scope and availability are discussed directly with NRTH.</p><a class='text-link' href='/projects/nrth-tms'>The NRTH TMS perspective <Icon /></a></div>
  </section>
  <section class='section company-slice'>
    <div data-reveal><span class='eyebrow'>03 / The company</span><h2>Independent<br />by design.</h2><a class='text-link' href='/about'>Meet NRTH Inc. <Icon /></a></div>
    <div data-reveal><p class='lead-copy'>Each field asks something different of us. The shared ambition is to make the next step clearer.</p><p>NRTH brings distinct venture directions together under one identity. We start with the people doing the work, examine the relationships around them, and give new ideas space to develop.</p><div class='company-subnav'><a class='text-link' href='/approach'>Our approach <Icon /></a><a class='text-link' href='/partnerships'>Work with NRTH <Icon /></a></div></div>
  </section>
  <section class='section research-feature' aria-labelledby='research-heading'>
    <div class='research-copy' data-reveal><span class='eyebrow'>04 / NRTH Labs / Form study 001</span><h2 id='research-heading'>A small change.<br />Another possibility.</h2><p>How does a relationship change a form? Move the controls and explore the same four strands from a different perspective.</p><p class='research-note'>A design experiment about continuity. Its geometry is part of this website’s identity.</p><a class='text-link' href='/research'>Explore the research journal <Icon /></a></div>
    <div data-reveal><VentureDemo slug='nrth-labs' compact /></div>
  </section>
  <section class='section editorial-section'>
    <div class='editorial-heading' data-reveal><div><span class='eyebrow'>05 / The journal</span><h2>Questions behind<br />the work.</h2></div><a class='text-link' href='/insights'>Read the journal <Icon /></a></div>
    <div class='editorial-grid'>{articles.slice(0,3).map((article, i) => <a class='editorial-card' href={'/insights/' + article.slug} data-reveal><div class='editorial-image'><Image src={articleArtwork[i].src} width={700} widths={[400,700]} sizes='(max-width:767px) 90vw, 30vw' alt={articleArtwork[i].alt} format='webp' loading='lazy' /><span><Icon name='upRight' /></span></div><div class='editorial-meta'><span class='eyebrow'>{article.category}</span><time datetime={article.publishedAt}>{new Date(article.publishedAt + 'T12:00:00Z').toLocaleDateString('en', {month:'short', day:'numeric', year:'numeric', timeZone:'UTC'})}</time></div><h3>{article.title}</h3><p>{article.description}</p></a>)}</div>
  </section>
  <section class='section investor-home'><div data-reveal><span class='eyebrow'>{siteContent.investors.label}</span><h2>{siteContent.investors.lines[0]}<br />{siteContent.investors.lines[1]}</h2></div><div data-reveal><p>{siteContent.investors.copy}</p><a class='text-link' href='/investors'>{siteContent.investors.link} <Icon /></a></div></section>
  <section class='section contact-section contact-invitation'><div><span class='eyebrow' data-reveal>06 / The next conversation</span><a href='/contact' class='contact-heading' data-reveal>Have a thought?<br />Let’s take it further. <Icon name='upRight' /></a></div><p data-reveal>A project. A partnership.<br />A question worth asking.<br /><a href='/contact'>Start a conversation <Icon /></a></p></section>
</Layout>
