---
import Layout from '../layouts/Layout.astro';
import ArtworkImage from './ArtworkImage.astro';
import ContactInvitation from './ContactInvitation.astro';
import JournalDiagram from './JournalDiagram.astro';
import {projectArtwork} from '../data/visuals';
import {getProjects,getArticles} from '../data/content';
import {journalGuideForArticle,journalReadingTime} from '../data/journal-guides';
import '../styles/journal-quality.css';
interface Props {article:import('../data/articles').Article;draft?:boolean;}
const {article,draft=false}=Astro.props;
const related=(await getProjects(draft)).filter(project=>article.related.includes(project.slug));
const furtherReading=(await getArticles(draft)).filter(item=>item.slug!==article.slug).slice(0,2);
const art=projectArtwork(article.category==='Research'?'nrth-labs':article.category==='Mobility'?'nrth-tms':'nrth-health');
// Repository illustrations describe their accompanying writing. Edited CMS
// paragraphs keep the standard reading layout instead of inheriting that model.
const guide=journalGuideForArticle(article);
const sections=guide?.sections.map((section,i)=>({...section,paragraphs:article.paragraphs.slice(section.startsAt,guide.sections[i+1]?.startsAt)}));
---
<Layout noindex={draft} title={article.title} description={article.description} kind='article' publishedAt={article.publishedAt} author={article.author}>
 {draft&&<aside class='preview-banner'><a href='/preview'>Editorial workspace</a><span data-preview-status>Draft preview</span></aside>}
 <article>
  <header class='page-heading article-intro journal-article-intro'><span class='section-label'>{article.category} · The NRTH journal</span><h1>{article.title}</h1><p>{article.description}</p><div class='article-meta'><span>{article.author}</span><time datetime={article.publishedAt}>{new Intl.DateTimeFormat('en',{dateStyle:'long',timeZone:'UTC'}).format(new Date(article.publishedAt+'T12:00:00Z'))}</time><span>{journalReadingTime(article)} min read</span></div></header>
  {guide&&<div class='journal-reading-guide'><span>In this perspective</span><nav aria-label='In this article'>{guide.sections.map(section=><a href={'#'+section.id}>{section.title}</a>)}</nav></div>}
  {guide?<JournalDiagram guide={guide} slug={article.slug}/>:<figure class='wide-art' data-image-reveal><ArtworkImage src={art.src} width={1600} height={1100} alt={art.alt} widths={[640,1100,1600]} sizes='90vw' format='webp' loading='lazy'/></figure>}
  <div class='article-prose journal-article-body'>
   {sections?sections.map(section=><section class='journal-prose-section' id={section.id} aria-labelledby={section.id+'-title'}><h2 id={section.id+'-title'}>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>):article.paragraphs.map(paragraph=><p>{paragraph}</p>)}
   {article.prompts?.length&&<section class='journal-reflection'><h2>Take the question<br/>with you.</h2><ul>{article.prompts.map(prompt=><li>{prompt}</li>)}</ul></section>}
  </div>
  {guide&&<section class='journal-application'><h2>{guide.application.title}</h2><div><p>{guide.application.text}</p><a class='inline-link' href={guide.application.href}>{guide.application.link}</a></div></section>}
 </article>
 <section class='editorial-split section-dark'><div><span class='section-label'>Explore the connections</span><h2>The question<br/>continues.</h2></div><div class='related-links'>{related.map(project=><a href={'/projects/'+project.slug}><strong>{project.name}</strong><span>{project.category}</span></a>)}</div></section>
 {furtherReading.length>0&&<section class='journal-further-reading'><div><span class='section-label'>A wider perspective</span><h2>Keep the<br/>question moving.</h2></div><div>{furtherReading.map(item=><a href={'/insights/'+item.slug}><span>{item.category} · {journalReadingTime(item)} min read</span><h3>{item.title}</h3><p>{item.description}</p></a>)}</div></section>}
 <ContactInvitation/>
</Layout>
