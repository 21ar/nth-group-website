---
import type {DesignStudy} from '../data/design-studies';
interface Props {kind:DesignStudy['kind'];title?:string;compact?:boolean;}
const {kind,title='An illustrative design study',compact=false}=Astro.props;
const uid='study-art-'+crypto.randomUUID().slice(0,8);
const stems=kind==='form'?[
 'M155 155 Q155 123 181 113 L320 53 Q337 45 354 53 L493 113 Q519 124 519 155 V316 Q519 342 493 355 L354 416 Q337 424 320 416 L181 355 Q155 342 155 316 Z',
 'M155 131 L337 219 L519 131','M337 219 V421','M242 91 L426 176 V382','M426 91 L242 176 V382','M155 233 L337 320 L519 233','M155 316 L337 234 L519 316',
 ]:kind==='handoff'?[
 'M118 306 C118 126 245 80 337 80 C450 80 563 151 563 285','M174 324 C174 194 255 133 337 133 C424 133 505 191 505 318','M228 324 C228 245 273 191 337 191 C405 191 448 253 448 324','M118 306 C128 391 212 419 275 361 C309 331 318 300 337 300 C357 300 365 333 396 361 C459 419 553 391 563 285',
 ]:kind==='conditions'?[
 'M337 60 C353 61 366 74 381 95 L517 294 C534 318 524 340 500 346 L174 346 C150 340 140 318 157 294 L293 95 C308 74 321 61 337 60 Z',
 'M337 60 C342 196 360 249 500 346','M337 60 C331 196 311 249 174 346','M157 294 C283 252 399 252 517 294','M245 177 C299 168 370 168 429 177','M174 346 C260 331 337 402 500 346',
 ]:Array.from({length:15},(_,i)=>{const x=104+i*34;const h=46+Math.pow(Math.sin(i/14*Math.PI),1.6)*230;return `M${x} ${250-h/2} V${250+h/2}`;});
const spectrum=Array.from({length:15},(_,i)=>{const height=46+Math.pow(Math.sin(i/14*Math.PI),1.6)*230;return {x:104+i*34,y:250-height/2,height};});
const descriptions:Record<DesignStudy['kind'],string>={form:'Rounded chrome edges connect into an open framework. Orange marks one continuous path through the arrangement.',handoff:'Several curved chrome paths fold toward one shared continuation, with an orange seam carrying the connection.',conditions:'A curved triangular lattice places the relationship between conditions and an application in view.',rhythm:'Repeated chrome elements open into a changing rhythm, with room between the individual moments.'};
---
<figure class:list={['study-art','study-art-'+kind,{'is-compact':compact}]} data-study-art>
 <svg viewBox='0 0 674 470' role='img' aria-labelledby={uid+'-title '+uid+'-description'}><title id={uid+'-title'}>{title}</title><desc id={uid+'-description'}>{descriptions[kind]} Creative illustration, not a scientific or operational model.</desc>
  <defs><linearGradient id={uid+'-material'} x1='0' y1='0' x2='1' y2='.8'><stop offset='0' stop-color='#686d76'/><stop offset='.2' stop-color='#e7e7df'/><stop offset='.33' stop-color='#969ca6'/><stop offset='.46' stop-color='#faf9ef'/><stop offset='.58' stop-color='#727b89'/><stop offset='.79' stop-color='#d7d7ce'/><stop offset='1' stop-color='#535b67'/></linearGradient><radialGradient id={uid+'-light'}><stop offset='0' stop-color='#8d98a8' stop-opacity='.18'/><stop offset='1' stop-color='#0a0b0d' stop-opacity='0'/></radialGradient></defs>
  <ellipse cx='337' cy='235' rx='326' ry='235' fill={'url(#'+uid+'-light)'}/>
  <g class='study-art-population'>{kind==='rhythm'?spectrum.map((piece,i)=><g class='study-art-piece' style={'--study-piece:'+i}><rect x={piece.x-8} y={piece.y+4} width='19' height={piece.height} rx='9.5' fill='#030508' opacity='.4'/><rect x={piece.x-9.5} y={piece.y} width='19' height={piece.height} rx='9.5' fill={'url(#'+uid+'-material)'}/><path d={`M${piece.x-4} ${piece.y+10} V${piece.y+piece.height-10}`} stroke='#edece7' stroke-width='1' stroke-linecap='round' opacity='.5'/></g>):stems.map((d,i)=><g class='study-art-piece' style={'--study-piece:'+i}><path d={d} stroke='#030508' stroke-width='15' fill='none' stroke-linecap='round' stroke-linejoin='round' transform='translate(2 4)' opacity='.38'/><path d={d} stroke={'url(#'+uid+'-material)'} stroke-width='12' fill='none' stroke-linecap='round' stroke-linejoin='round'/><path d={d} stroke='#edece7' stroke-width='1' fill='none' stroke-linecap='round' stroke-linejoin='round' opacity='.44' transform='translate(-2 -2)'/></g>)}</g>
  <path class='study-art-seam' d={kind==='form'?'M155 131 L337 219 V421':kind==='handoff'?'M174 324 C174 194 255 133 337 133 C424 133 505 191 505 318':kind==='conditions'?'M337 60 C342 196 360 249 500 346':stems[8]} stroke='#ff7844' stroke-width={kind==='rhythm'?5:3.5} fill='none' stroke-linecap='round' stroke-linejoin='round'/>
 </svg>
</figure>
