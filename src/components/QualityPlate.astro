---
import {makeQualityGraphic} from '../data/quality-graphics';
import '../styles/quality-plate.css';
interface Props {kind: string; variant?: string; label?: string; compact?: boolean;}
const {kind, variant = '', label, compact = false} = Astro.props;
const graphic = makeQualityGraphic(kind, variant);
const uid = `quality-${crypto.randomUUID()}`;
const id = (name: string) => `${uid}-${name}`;
const captioned = !compact || Boolean(label);
---
<figure class:list={['quality-plate', {'quality-plate--compact': compact, 'quality-plate--uncaptioned': !captioned}]} data-quality-plate data-quality-kind={graphic.kind} data-quality-variant={variant || graphic.kind}>
  <div class="quality-plate-stage">
    <svg class="quality-plate-art" viewBox="0 0 960 640" role="img" aria-labelledby={id('title')} aria-describedby={id('description')} xmlns="http://www.w3.org/2000/svg">
      <title id={id('title')}>{label || graphic.name}</title>
      <desc id={id('description')}>{graphic.description} This is an illustrative material study, rather than product data.</desc>
      <defs>
        <radialGradient id={id('background')} cx="48%" cy="43%" r="66%"><stop stop-color="#22252a"/><stop offset=".64" stop-color="#111317"/><stop offset="1" stop-color="#090a0c"/></radialGradient>
        <radialGradient id={id('halo')} cx="60%" cy="40%" r="50%"><stop stop-color="#99714e" stop-opacity=".14"/><stop offset="1" stop-color="#99714e" stop-opacity="0"/></radialGradient>
        <linearGradient id={id('chrome')} x1="0" y1="0" x2=".8" y2="1" gradientUnits="objectBoundingBox"><stop stop-color="#52575e"/><stop offset=".1" stop-color="#f6f4ee"/><stop offset=".23" stop-color="#9a9fa7"/><stop offset=".38" stop-color="#2e343e"/><stop offset=".47" stop-color="#555d68"/><stop offset=".57" stop-color="#eee9dd"/><stop offset=".68" stop-color="#aab0b7"/><stop offset=".86" stop-color="#444b54"/><stop offset="1" stop-color="#777c82"/></linearGradient>
        <linearGradient id={id('chrome-alt')} x1=".2" y1="1" x2="1" y2="0"><stop stop-color="#333943"/><stop offset=".17" stop-color="#7f858d"/><stop offset=".37" stop-color="#d8d8d5"/><stop offset=".43" stop-color="#fcf9ef"/><stop offset=".51" stop-color="#575f68"/><stop offset=".7" stop-color="#282f38"/><stop offset=".92" stop-color="#aaaeb2"/><stop offset="1" stop-color="#e5e2da"/></linearGradient>
        <linearGradient id={id('orange')} x1="0" y1="0" x2=".7" y2="1"><stop stop-color="#fdba7a"/><stop offset=".2" stop-color="#ff9354"/><stop offset=".46" stop-color="#b14e29"/><stop offset=".58" stop-color="#ff8748"/><stop offset=".8" stop-color="#e97036"/><stop offset="1" stop-color="#8c3e22"/></linearGradient>
        <linearGradient id={id('glint')} x1="0" y1="0" x2="1" y2=".8"><stop stop-color="#fffdf3" stop-opacity=".88"/><stop offset=".36" stop-color="#fffdf3" stop-opacity=".08"/><stop offset=".6" stop-color="#fffdf3" stop-opacity=".58"/><stop offset="1" stop-color="#fffdf3" stop-opacity="0"/></linearGradient>
        <radialGradient id={id('node')} cx="30%" cy="22%" r="76%"><stop stop-color="#fcfbf6"/><stop offset=".21" stop-color="#d6d7d6"/><stop offset=".5" stop-color="#7b838c"/><stop offset=".72" stop-color="#303843"/><stop offset=".86" stop-color="#a1a6ab"/><stop offset="1" stop-color="#333a43"/></radialGradient>
        <radialGradient id={id('orange-node')} cx="30%" cy="22%" r="76%"><stop stop-color="#ffe0a2"/><stop offset=".28" stop-color="#ff9a57"/><stop offset=".6" stop-color="#ee773d"/><stop offset="1" stop-color="#853c21"/></radialGradient>
        <radialGradient id={id('ground')}><stop stop-color="#000" stop-opacity=".6"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
        {graphic.pieces.map((piece, index) => <path id={id(`piece-${index}`)} d={piece.path}/>)}
      </defs>
      <rect width="960" height="640" fill={`url(#${id('background')})`}/>
      <rect width="960" height="640" fill={`url(#${id('halo')})`}/>
      <g class="quality-plate-grid" aria-hidden="true" stroke="#b6bbc0" stroke-width=".65" fill="none">
        <path d="M80 482 Q480 620 880 482 M120 458 Q480 578 840 458 M170 435 Q480 538 790 435 M228 416 Q480 499 732 416"/>
        <path d="M480 400L480 594 M390 397L277 574 M300 390L93 535 M570 397L683 574 M660 390L867 535"/>
      </g>
      <ellipse cx="480" cy="492" rx="318" ry="79" fill={`url(#${id('ground')})`}/>
      <g class="quality-plate-motion">
        <g class="quality-plate-traces" fill="none" stroke="#b0aaa0" stroke-width=".85" aria-hidden="true">
          {graphic.traces.map(path => <path d={path} pathLength="1"/>)}
        </g>
        <g fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {graphic.pieces.map((piece, index) => <g class="quality-plate-piece" style={`--piece-x:${piece.x}px;--piece-y:${piece.y}px;--piece-turn:${piece.rotation}deg;--piece-delay:${Math.min(index / Math.max(1, graphic.pieces.length - 1) * .16, .16)}`}>
            <use href={`#${id(`piece-${index}`)}`} stroke="#030406" stroke-width={piece.width + 7} opacity=".48" transform="translate(2 7)"/>
            <use href={`#${id(`piece-${index}`)}`} stroke="#333840" stroke-width={piece.width + 2}/>
            <use href={`#${id(`piece-${index}`)}`} stroke={`url(#${id(piece.orange ? 'orange' : index % 2 ? 'chrome-alt' : 'chrome')})`} stroke-width={piece.width}/>
            <use href={`#${id(`piece-${index}`)}`} stroke={`url(#${id('glint')})`} stroke-width={Math.max(1.5, piece.width * .115)} opacity={piece.orange ? '.5' : '.68'} transform={`translate(${-piece.width * .13} ${-piece.width * .17})`}/>
            <use href={`#${id(`piece-${index}`)}`} stroke="#10151b" stroke-width=".9" opacity=".42" transform={`translate(${piece.width * .3} ${piece.width * .32})`}/>
          </g>)}
        </g>
        <g class="quality-plate-nodes" aria-hidden="true">
          {graphic.nodes.map(node => <g><circle cx={node.x + 2} cy={node.y + 4} r={node.radius + 1.5} fill="#040508" opacity=".7"/><circle cx={node.x} cy={node.y} r={node.radius} fill={`url(#${id(node.orange ? 'orange-node' : 'node')})`}/><circle cx={node.x - node.radius * .27} cy={node.y - node.radius * .3} r={node.radius * .12} fill="#fff8e7" opacity=".75"/></g>)}
        </g>
      </g>
      <path class="quality-plate-edge" d="M41 82V41H82 M878 41H919V82 M919 558V599H878 M82 599H41V558" fill="none" stroke="#6c6c6b" stroke-width=".8" aria-hidden="true"/>
    </svg>
  </div>
  {captioned && <figcaption><span>{label || graphic.name}</span><span class="quality-plate-note">An illustrative perspective</span></figcaption>}
</figure>
<script>import '../scripts/quality-plate';</script>
