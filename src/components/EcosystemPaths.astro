---
import Icon from './Icon.astro';
const paths = [
  { name: 'A more connected operation', field: 'Movement', text: 'Transportation planning, vehicle context, resources, and partner handoffs address different parts of the same journey.', nodes: [{name:'TMS',slug:'nrth-tms',role:'Plan the work'}, {name:'Telematics',slug:'nrth-telematics',role:'Understand the signals'}, {name:'Fleet',slug:'nrth-fleet',role:'Coordinate resources'}, {name:'Logistics',slug:'nrth-logistics',role:'Connect the handoffs'}], question:'Where does information stop moving when the work moves to another team?' },
  { name: 'From a human question to a useful system', field: 'People & technology', text: 'Health starts with the person. Labs explores the uncertainties. Systems considers the foundations that could support a practical workflow.', nodes: [{name:'Health',slug:'nrth-health',role:'Start with the person'}, {name:'Labs',slug:'nrth-labs',role:'Test the assumption'}, {name:'Systems',slug:'nrth-systems',role:'Shape the foundation'}], question:'What is the smallest change that would make the next step easier for someone?' },
  { name: 'New possibilities between disciplines', field: 'Exploration', text: 'Materials, research, and experiences offer different places to begin a conversation. Shared questions can lead to unexpected connections.', nodes: [{name:'Chemicals',slug:'nrth-chemicals',role:'Explore an application'}, {name:'Labs',slug:'nrth-labs',role:'Investigate the question'}, {name:'Events',slug:'nrth-events',role:'Bring perspectives together'}], question:'Which other perspective could help us understand this question better?' },
];
---
<section class="section ecosystem-paths" aria-labelledby="paths-heading"><div class="editorial-heading" data-reveal><div><span class="eyebrow">The connections between</span><h2 id="paths-heading">Nine perspectives.<br />More ways forward.</h2></div><p>Each venture has its own focus. These possible pathways show how their perspectives could complement one another.</p></div><div class="path-list">{paths.map((path,i) => <details class="path-card" open={i===0} data-reveal><summary><span class="eyebrow">0{i+1} / {path.field}</span><h3>{path.name}</h3><Icon name="plus" /></summary><div class="path-content"><p>{path.text}</p><div class="path-nodes">{path.nodes.map(node => <a href={`/projects/${node.slug}`}><span class="eyebrow">NRTH</span><h4>{node.name}</h4><p>{node.role}</p><Icon name="upRight" /></a>)}</div><p class="path-question"><span class="eyebrow">A question to start with</span>{path.question}</p></div></details>)}</div><p class="path-note">These are possible collaboration pathways, not a claim that every project shares a live platform or integration.</p></section>
