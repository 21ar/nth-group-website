---
import '../styles/editorial-expansion.css';
interface Props {kind:'approach'|'partnership';}
const {kind}=Astro.props;
const study=kind==='approach'?{
 id:'worked-study',label:'An illustrative investigation',title:'One changed window.\nA more useful question.',intro:'Follow a synthetic delivery exception from an initial observation to a bounded research outline. The sequence produces a clear question, a proposed method and a practical next review.',
 inputs:[{label:'Starting situation',text:'A receiving window changes after a delivery has been assigned.'},{label:'People in view',text:'A transport coordinator, the receiving team and the person permitted to approve a plan change.'},{label:'Boundary',text:'Examine the interpretation of a handoff summary. No live tracking, optimization or dispatch execution is involved.'}],
 steps:[
  {key:'question',title:'Name the uncertainty.',text:'Can the recipient identify the next responsible person and the changed commitment from a proposed handoff summary? This question is smaller than “improve delivery coordination.” It targets an interpretation that could change the design of the summary.',output:'A question tied to one task: understand who can continue the changed assignment.',test:'If the actual difficulty concerns a different part of the process, revise the question before building a prototype.'},
  {key:'source',title:'Prepare a credible example.',text:'Create a synthetic job with an original window, an updated window and a note naming who supplied the change. Keep the observation time separate from the proposed commitment. Give the participant only the context a recipient would normally have, and state which assumptions are invented.',output:'A scenario sheet and a summary prototype containing the same clearly identified inputs.',test:'Do the conditions resemble the work being discussed? Synthetic data makes a review possible; it does not establish that the underlying process is accurate.'},
  {key:'responsibility',title:'Observe the interpretation.',text:'Ask a suitable participant to explain what changed, who can act and what they would need before continuing. Record the interpretation and any hesitation separately from an explanation of why it happened. Compare the answer with the responsibility stated in the synthetic case.',output:'Task observations connected to the conditions under which they were made.',test:'A correct answer in this task may support comprehension of this summary. Preference for its appearance leaves the original question open.'},
  {key:'decision',title:'Give the next step a reason.',text:'If responsibility remains unclear, revise how the summary describes it and investigate the revised version. If the recipient identifies it but lacks context for the commitment, focus the next review on that gap. If the summary is understood, investigate whether it fits the actual handoff before drawing a wider conclusion.',output:'A proposed next review with its question, necessary context and unresolved dependencies.',test:'No participant result is reported here. These are possible interpretations and decisions for a future, appropriately scoped investigation.'}
 ],
 result:'A prepared investigation: one interpretation question, a synthetic scenario, a proposed prototype task and explicit limits. Each artifact has a purpose in deciding what to examine next.',
 href:'/research#experiment',link:'Prepare your own experiment outline',
 }: {
 id:'illustrative-brief',label:'A filled example introduction',title:'Bring a contribution.\nShare a focused question.',intro:'A hypothetical operations partner introduces a changed receiving window. This filled brief shows how context, contributions and a proposed review can fit together without implying that an engagement has been agreed.',
 inputs:[{label:'Interest',text:'NRTH Logistics, with a connection to NRTH TMS and NRTH Systems.'},{label:'Proposed contribution',text:'An anonymized workflow description, operational terminology and access to a suitable process reviewer, subject to agreement.'},{label:'First question',text:'What information and acknowledgement should accompany a changed receiving commitment?'}],
 steps:[
  {key:'question',title:'The situation to understand.',text:'“Our illustrative process transfers a delivery commitment between a planning team and a receiving team. When the receiving window changes, we want to understand what the next recipient needs to interpret the change and accept responsibility for continuing it.”',output:'A specific handoff, the people involved and the exception that makes the question visible.',test:'Describe one representative situation before proposing a platform, integration or fixed set of features.'},
  {key:'source',title:'The contributions to establish.',text:'“A prospective operations partner could explain the actual process and review the meaning of its terms. A technical contributor could examine the information boundary and its acknowledgement. A research contribution could turn the interpretation question into a bounded review.”',output:'Separate contributions connected to the same question, with participants still to be agreed.',test:'This is a possible division of work. It does not assign people, promise NRTH capabilities or establish access to private information.'},
  {key:'responsibility',title:'The first review to propose.',text:'“Begin with an anonymized process map and one synthetic change. Agree what the recipient needs to know, which acknowledgement changes responsibility and which conditions remain unresolved. Use that discussion to decide whether a more detailed investigation is useful.”',output:'A proposed first artifact, a purpose for reviewing it and a decision the review could support.',test:'Timing, confidentiality, intellectual property, access and commercial arrangements belong to the actual discussion and any resulting agreement.'}
 ],
 result:'A useful introduction names the problem, explains the contribution and proposes a bounded first exchange. It leaves unconfirmed responsibilities visible instead of presenting a hypothetical collaboration as completed work.',href:'#prepare',link:'Shape your own introduction'
};
const id='editorial-study-'+kind;
---
<section class={'editorial-study editorial-study--'+kind} id={study.id} aria-labelledby={id+'-heading'}>
 <div class='editorial-study-heading'><div><span class='section-label'>{study.label}</span><h2 id={id+'-heading'}>{study.title.split('\n').map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</h2></div><p>{study.intro}</p></div>
 <dl class='editorial-study-record'>{study.inputs.map(input=><div><dt>{input.label}</dt><dd>{input.text}</dd></div>)}</dl>
 <div class='editorial-study-path'>
  <figure class='editorial-study-art'>
   <svg viewBox='0 0 650 650' role='img' aria-label={kind==='approach'?'A changed commitment passes through a question, an example, an observation and a next decision.':'Operational, technical and research contributions meet around one handoff question.'}>
    <defs><linearGradient id={id+'-silver'} x1='80' y1='80' x2='530' y2='570' gradientUnits='userSpaceOnUse'><stop stop-color='#eeeae1'/><stop offset='.38' stop-color='#788593'/><stop offset='.62' stop-color='#e6e8ea'/><stop offset='1' stop-color='#68717b'/></linearGradient></defs>
    {kind==='approach'?<>
     <path d='M149 155C335 26 572 204 491 333C427 435 186 211 148 399C103 604 443 630 506 482' fill='none' stroke={'url(#'+id+'-silver)'} stroke-width='25' stroke-linecap='round' opacity='.35'/>
     <g data-study-layer='question'><path d='M149 155C255 76 355 101 420 162' fill='none' stroke='#ff743b' stroke-width='25' stroke-linecap='round'/><circle cx='151' cy='155' r='45' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='10'/><path d='M138 143C138 126 166 126 166 143C166 155 153 151 153 165M153 179V181' fill='none' stroke='#ff743b' stroke-width='5' stroke-linecap='round'/></g>
     <g data-study-layer='source'><path d='M420 162C535 218 553 302 469 350' fill='none' stroke='#ff743b' stroke-width='25' stroke-linecap='round'/><rect x='459' y='213' width='91' height='110' rx='19' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='9'/><path d='M480 242H530M480 265H519M480 288H507' stroke='#ff743b' stroke-width='5' stroke-linecap='round'/></g>
     <g data-study-layer='responsibility'><path d='M469 350C344 395 204 284 151 381' fill='none' stroke='#ff743b' stroke-width='25' stroke-linecap='round'/><circle cx='160' cy='430' r='47' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='10'/><circle cx='160' cy='423' r='17' fill='none' stroke='#ff743b' stroke-width='5'/><path d='M160 393V402M160 444V453M131 423H140M181 423H190' stroke='#ff743b' stroke-width='4' stroke-linecap='round'/></g>
     <g data-study-layer='decision'><path d='M151 381C111 588 435 630 506 482' fill='none' stroke='#ff743b' stroke-width='25' stroke-linecap='round'/><circle cx='506' cy='482' r='46' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='10'/><path d='M485 482L500 497L528 468' stroke='#ff743b' stroke-width='5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></g>
    </>:<>
     <path d='M112 174C259 142 205 350 329 350C447 350 419 125 552 172M107 496C247 559 255 317 329 350C414 388 440 542 553 493M327 83V576' fill='none' stroke={'url(#'+id+'-silver)'} stroke-width='18' opacity='.4' stroke-linecap='round'/>
     <g data-study-layer='question'><path d='M112 174C259 142 205 350 329 350' fill='none' stroke='#ff743b' stroke-width='18' stroke-linecap='round'/><circle cx='112' cy='174' r='26' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='8'/></g>
     <g data-study-layer='source'><path d='M107 496C247 559 255 317 329 350M327 83V350' fill='none' stroke='#ff743b' stroke-width='18' stroke-linecap='round'/><circle cx='107' cy='496' r='26' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='8'/><circle cx='327' cy='83' r='26' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='8'/></g>
     <g data-study-layer='responsibility'><path d='M329 350C447 350 419 125 552 172M329 350C414 388 440 542 553 493M327 350V576' fill='none' stroke='#ff743b' stroke-width='18' stroke-linecap='round'/><circle cx='552' cy='172' r='26' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='8'/><circle cx='553' cy='493' r='26' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='8'/></g>
     <path d='M287 306L332 280L377 306V369L332 396L287 369Z' fill='#151a21' stroke={'url(#'+id+'-silver)'} stroke-width='9'/><path d='M287 306L332 333L377 306M332 333V396' fill='none' stroke='#ff743b' stroke-width='5'/>
    </>}
   </svg>
   <figcaption>{kind==='approach'?'Each stage produces an artifact that informs the next. A changed observation can send the investigation back to its question.':'Contributions retain their distinct responsibilities while meeting around one specific question.'}</figcaption>
  </figure>
  <div><div class='disclosure-list'>{study.steps.map((step,i)=><details name={id+'-steps'} data-study-step={step.key} open={i===0}><summary>{step.title}<span aria-hidden='true'>+</span></summary><div><p>{step.text}</p><h3>What it produces</h3><p>{step.output}</p><h3>What to review</h3><p>{step.test}</p></div></details>)}</div><div class='editorial-study-output'><h3>{kind==='approach'?'The prepared output.':'A useful starting point.'}</h3><p>{study.result}</p></div><p class='editorial-study-limit'>Illustrative example with synthetic inputs. The sequence describes a proposed review.</p><a class='inline-link editorial-study-action' href={study.href}>{study.link}</a></div>
 </div>
</section>
<style>
 [data-study-layer]{opacity:.2;transition:opacity .65s ease}.editorial-study:has([data-study-step='question'][open]) [data-study-layer='question'],.editorial-study:has([data-study-step='source'][open]) [data-study-layer='source'],.editorial-study:has([data-study-step='responsibility'][open]) [data-study-layer='responsibility'],.editorial-study:has([data-study-step='decision'][open]) [data-study-layer='decision']{opacity:1}@media(prefers-reduced-motion:reduce){[data-study-layer]{transition:none}}
</style>
