---
import Icon from './Icon.astro';
import {demos} from '../data/demos';
interface Props {slug: string; compact?: boolean;}
const {slug, compact = false} = Astro.props;
const demo = demos[slug];
const id = 'demo-' + slug;
---
<div class:list={['venture-demo', {'demo-compact': compact}]} data-demo={demo.kind} data-demo-slug={slug}>
  <div class='demo-toolbar'><span class='demo-identity'><span class='demo-ring' aria-hidden='true'></span>{slug.replace('nrth-', 'NRTH ').replace('tms', 'TMS').replace(/(NRTH )([a-z])/, (_: string, a: string, b: string) => a + b.toUpperCase())}</span><span class='concept-label'>Interactive concept / Sample data</span></div>
  {demo.kind === 'dispatch' && <div class='dispatch-app'>
    <aside class='demo-sidebar'><span class='eyebrow'>Shipment NR-1042</span><h3>Plan the<br />next move.</h3><nav aria-label='Sample shipment steps'>{['Route', 'Vehicle', 'Review'].map((label, i) => <button type='button' data-dispatch-step={i} aria-current={i === 0 ? 'step' : undefined}><span>0{i + 1}</span>{label}<Icon /></button>)}</nav><p>A sample workflow.<br />No shipment is dispatched.</p></aside>
    <div class='demo-workspace'>
      <div data-dispatch-panel='0'><div class='demo-heading'><span class='eyebrow'>01 / The route</span><h3>Where does the work go?</h3></div><div class='demo-fields'><label for={id + '-origin'}>Origin<select id={id + '-origin'} data-demo-origin><option>Vancouver, BC</option><option>Toronto, ON</option><option>Edmonton, AB</option></select></label><label for={id + '-destination'}>Destination<select id={id + '-destination'} data-demo-destination><option>Calgary, AB</option><option>Montréal, QC</option><option>Vancouver, BC</option></select></label></div><div class='shipment-summary'><div><span>Shipment type</span><strong>Sample dry freight</strong></div><div><span>Load</span><strong>16 pallets</strong></div><div><span>Priority</span><strong>Standard</strong></div></div><p class='demo-error' data-dispatch-error role='status'></p><button class='demo-primary' type='button' data-dispatch-next='1'>Choose a vehicle <Icon /></button></div>
      <div data-dispatch-panel='1' hidden><div class='demo-heading'><span class='eyebrow'>02 / The vehicle</span><h3>A resource that fits.</h3></div><div class='vehicle-choices'>{[{id: 'NR-01', name: 'Dry van', capacity: '24 pallets'}, {id: 'NR-02', name: 'Box truck', capacity: '18 pallets'}, {id: 'NR-03', name: 'Cargo van', capacity: '8 pallets'}].map((v, i) => <label class='vehicle-choice'><input type='radio' name={id + '-vehicle'} value={v.id} data-demo-vehicle checked={i === 0} /><span><strong>{v.name}</strong><span>{v.id} / {v.capacity}</span></span><span class='vehicle-fit'>{i === 2 ? 'Below load size' : 'Fits sample load'}</span></label>)}</div><p class='demo-error' data-vehicle-error role='status'></p><button class='demo-primary' type='button' data-dispatch-next='2'>Review the plan <Icon /></button></div>
      <div data-dispatch-panel='2' hidden><div class='demo-heading'><span class='eyebrow'>03 / The handoff</span><h3>The next step, in view.</h3></div><div class='route-review'><div><span>Origin</span><strong data-route-origin>Vancouver, BC</strong></div><span class='route-review-link' aria-hidden='true'></span><div><span>Destination</span><strong data-route-destination>Calgary, AB</strong></div></div><div class='shipment-summary'><div><span>Vehicle</span><strong data-route-vehicle>NR-01</strong></div><div><span>Responsibility</span><strong>Sample dispatch team</strong></div><div><span>State</span><strong data-plan-state>Ready for review</strong></div></div><button class='demo-primary' type='button' data-dispatch-create>Create sample plan <Icon /></button><div class='demo-complete' data-plan-complete hidden role='status'><strong>Your sample plan is ready.</strong><p>Inspect the handoff or save the example. This concept has not dispatched a shipment.</p><button class='demo-download' type='button' data-plan-download>Download sample plan <Icon name='down' /></button><button class='demo-download' type='button' data-plan-reset>Start again</button></div></div>
      <p class='demo-workspace-note'>A concept for understanding transportation work. Current NRTH TMS scope is available through a conversation.</p>
    </div>
  </div>}
  {demo.kind === 'sequence' && <div class='sequence-app'><div class='sequence-nav' role='tablist' aria-label='Explore the illustrative workflow'>{demo.steps?.map((step, i) => <button id={id + '-step-' + i} type='button' role='tab' aria-selected={i === 0} aria-controls={id + '-panel-' + i} tabindex={i === 0 ? 0 : -1} data-sequence-step={i}><span>0{i + 1}</span>{step.title}</button>)}</div>{demo.steps?.map((step, i) => <div id={id + '-panel-' + i} role='tabpanel' aria-labelledby={id + '-step-' + i} hidden={i > 0} data-sequence-panel class='sequence-panel'><span class='eyebrow'>Responsibility / {step.owner}</span><h3>{step.title}, with context.</h3><p>{step.detail}</p><div class='next-action'><span class='eyebrow'>The useful next step</span><strong>{step.action}</strong></div></div>)}</div>}
  {demo.kind === 'telemetry' && <div class='telemetry-app'><div class='demo-heading'><span class='eyebrow'>Vehicle NR-01 / Sample journey</span><h3>Read the movement.</h3></div><div class='telemetry-route' aria-hidden='true'><span class='route-line'></span>{Array.from({length: 6}, (_, i) => <span class='route-node' style={'--node:' + i}></span>)}<span class='route-marker' data-telemetry-marker></span></div><div class='telemetry-metrics'><div><span>Sample speed</span><strong data-telemetry-speed>62 <small>km/h</small></strong></div><div><span>Activity</span><strong data-telemetry-activity>Moving</strong></div><div><span>Signal age</span><strong data-telemetry-age>4 <small>sec</small></strong></div></div><label class='timeline-control' for={id + '-time'}><span>Explore the sample timeline</span><output data-telemetry-time>09:14</output><input id={id + '-time'} type='range' min='0' max='5' value='2' step='1' data-telemetry-time-input /></label><p class='demo-insight' data-telemetry-insight>The vehicle is moving and the sample signal is recent.</p></div>}
  {demo.kind === 'fleet' && <div class='fleet-app'><div class='demo-heading'><span class='eyebrow'>Three sample records</span><h3>Readiness, with context.</h3></div><div class='demo-filter' role='group' aria-label='Filter sample vehicles'>{['All', 'Ready', 'Review'].map((filter, i) => <button type='button' data-fleet-filter={filter} aria-pressed={i === 0}>{filter}</button>)}</div><div class='fleet-records'>{[{id: 'NR-01', type: 'Dry van', state: 'Ready', note: 'The sample record has no open readiness checks.'}, {id: 'NR-02', type: 'Box truck', state: 'Review', note: 'A sample maintenance check needs an owner before the next assignment.'}, {id: 'NR-03', type: 'Cargo van', state: 'Ready', note: 'Consider the smaller load space when choosing the next assignment.'}].map((v, i) => <button class='fleet-record' type='button' data-fleet-record={v.id} data-fleet-state={v.state} data-fleet-note={v.note} aria-pressed={i === 0}><span>{v.id}</span><strong>{v.type}</strong><span class='fleet-state'>{v.state}</span><Icon /></button>)}</div><div class='fleet-detail' role='status'><span class='eyebrow' data-fleet-selected>Selected / NR-01</span><p data-fleet-detail>The sample record has no open readiness checks.</p></div></div>}
  {demo.kind === 'workflow' && <div class='workflow-app'><div class='demo-heading'><span class='eyebrow'>Three sample requests</span><h3>A workflow you can inspect.</h3></div><label class='workflow-label' for={id + '-rule'}>Choose a rule<select id={id + '-rule'} data-workflow-rule><option value='review'>Route requests needing review</option><option value='all'>Summarize every request</option></select></label><div class='workflow-nodes'>{['Input', 'Rule', 'Next action'].map((title, i) => <div data-workflow-node={i}><span class='workflow-dot'></span><strong>{title}</strong><span data-workflow-state>Waiting</span></div>)}</div><button class='demo-primary' type='button' data-workflow-run>Run sample workflow <Icon /></button><div class='workflow-output' data-workflow-output hidden role='status'></div></div>}
  {demo.kind === 'materials' && <div class='materials-app'><div class='demo-heading'><span class='eyebrow'>Application questions</span><h3>Make the brief useful.</h3></div><div class='material-choices' role='group' aria-label='Explore a material application'>{['Coatings', 'Water processes', 'Manufacturing'].map((name, i) => <button type='button' data-material-choice={i} aria-pressed={i === 0}>{name}</button>)}</div><div class='material-context'><span class='eyebrow'>Start with the requirements</span><h4 data-material-title>Coatings</h4><ul data-material-questions><li>What surface and environment are involved?</li><li>Which performance requirements matter?</li><li>What specifications and documentation are needed?</li></ul></div><button class='demo-primary' type='button' data-material-brief>Save a conversation brief <Icon name='down' /></button><p class='demo-workspace-note'>An application framework, rather than a product recommendation or safety specification.</p></div>}
  {demo.kind === 'agenda' && <div class='agenda-app'><div class='demo-heading'><span class='eyebrow'>A sample gathering</span><h3>Give the time a purpose.</h3></div><div class='demo-fields'><label for={id + '-format'}>Format<select id={id + '-format'} data-agenda-format><option value='exchange'>Ideas exchange</option><option value='forum'>Product forum</option></select></label><label for={id + '-duration'}>Duration<select id={id + '-duration'} data-agenda-duration><option value='60'>60 minutes</option><option value='90' selected>90 minutes</option><option value='120'>120 minutes</option></select></label></div><div class='agenda-blocks' data-agenda-blocks aria-live='polite'></div><button class='demo-download' type='button' data-agenda-download>Save sample agenda <Icon name='down' /></button></div>}
  {demo.kind === 'lab' && <div class='lab-app'><div class='lab-canvas-wrap'><canvas data-lab-canvas role='img' aria-label='Four continuous strands transform between independent rings and a connected infinity form'></canvas><span class='lab-study-label'>NRTH Form Study / 001</span></div><div class='lab-controls'><label for={id + '-connection'}><span>Connection</span><output data-lab-connection-value>50%</output><input id={id + '-connection'} type='range' min='0' max='100' value='50' data-lab-connection /></label><label for={id + '-perspective'}><span>Perspective</span><output data-lab-perspective-value>0°</output><input id={id + '-perspective'} type='range' min='-45' max='45' value='0' data-lab-perspective /></label><p>Change a relationship.<br />Watch a different form emerge.</p></div></div>}
  <noscript><p class='demo-nojs'>This concept uses JavaScript for interaction. Its purpose: {demo.description}</p></noscript>
</div>
<script>import '../scripts/demos';</script>
