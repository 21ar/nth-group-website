---
import {Image} from 'astro:assets';
import hero from '../assets/fold-hero.png';
import {getIndustries,getSiteContent} from '../data/content';
interface Props {draft?:boolean;}
const {draft=false}=Astro.props;
const industries=await getIndustries(draft),siteContent=await getSiteContent(draft);
const fields=['Mobility','Health','Systems','Materials','Events','Research'].map(name=>industries.find(field=>field.name===name)!);
---
<section class='living-fold' data-fold-story data-story data-field='Mobility' aria-label='Progress unfolds across NRTH'>
  <div class='fold-viewport'>
    <div class='fold-scene' data-hero-scene data-scene-state='static'>
      <Image class='fold-still' src={hero} width={1600} widths={[640,1000,1600]} sizes='100vw' alt='Coral, ivory and lavender sheets open into a flowing architectural landscape' format='webp' quality={85} loading='eager' fetchpriority='high' />
    </div>
    <div class='fold-intro' data-fold-intro>
      <h1>{siteContent.opening.lines[0]}<br />{siteContent.opening.lines[1]}</h1>
      <p>{siteContent.opening.copy.split('\n').map((line,index)=><>{index>0&&<br />}{line}</>)}</p>
    </div>
    <div class='fold-content' data-fold-content>
      {fields.map((field,index)=><div class:list={['fold-field-panel',{'fold-panel-wide-copy':['Materials','Research'].includes(field.name)}]} role='tabpanel' id={'fold-panel-'+index} aria-labelledby={'fold-tab-'+index} data-fold-panel hidden={index!==0}>
        <div class='fold-field-copy'><span class='field-name'>{field.name}</span><h2>{field.title[0]}<br />{field.title[1]}</h2><p>{field.copy}</p></div>
        <div class='fold-ventures' aria-label={field.name+' ventures'}>{field.ventures.map(name=><a href={'/projects/nrth-'+name.toLowerCase()}><span>NRTH {name}</span></a>)}</div>
      </div>)}
      <div class='fold-fields' role='tablist' aria-label='Explore a field' aria-orientation='horizontal'>{fields.map((field,index)=><button type='button' role='tab' id={'fold-tab-'+index} aria-controls={'fold-panel-'+index} aria-selected={index===0} tabindex={index===0?0:-1} data-fold-field={field.name}>{field.name}</button>)}</div>
    </div>
    <a class='fold-scroll' href='#ecosystem'>Scroll to unfold</a>
  </div>
</section>
<noscript><div class='fold-nojs-links'>{fields.map(field=><a href={'/projects?field='+field.name}>{field.name}</a>)}</div></noscript>
<script>import '../scripts/fold';</script>
