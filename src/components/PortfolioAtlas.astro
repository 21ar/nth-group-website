---
import {atlasPaths} from '../data/atlas-paths';
import {getProjects} from '../data/content';
import {venturePerspectives} from '../data/venture-perspectives';
import '../styles/portfolio-atlas.css';
interface Props {draft?:boolean;}
const {draft=false}=Astro.props;
const projects=await getProjects(draft);
const atlasProjects=projects.map((project,i)=>({...project,x:150+(i%3)*300,y:120+Math.floor(i/3)*260}));
// A shared drawing vocabulary, with a different organization for each question.
const forms=atlasPaths;
const uid='portfolio-atlas';
---
<div class='portfolio-atlas' data-portfolio-atlas data-atlas-selected={projects[0].slug}>
 <div class='atlas-fields' role='group' aria-label='Explore ventures by field' hidden data-atlas-tools>
  {['All','Mobility','Health','Systems','Materials','Events','Research'].map((field,i)=><button type='button' data-atlas-field={field} aria-pressed={i===0}>{field==='All'?'All directions':field}</button>)}
 </div>
 <div class='atlas-workspace'>
  <div class='atlas-reading'>
   {projects.map((project,i)=><article data-atlas-panel={project.slug} hidden={i!==0}>
    <p class='atlas-field'>{project.category}</p><h3>{project.name}</h3>
    <p class='atlas-question'>{venturePerspectives[project.slug].question}</p>
    <dl><div><dt>Who it concerns</dt><dd>{venturePerspectives[project.slug].audience.join(' · ')}</dd></div><div><dt>The direction</dt><dd>{project.description}</dd></div></dl>
    <div class='atlas-links'><a href={'/projects/'+project.slug} data-atlas-open>Look inside the work</a><a href={'/industries/'+project.category.toLowerCase()}>The wider field</a></div>
   </article>)}
   <p class='atlas-scope'>Illustrative forms. Each overview explains the question and separates the idea from current scope.</p>
  </div>
  <div class='atlas-surface'>
   <svg class='atlas-graphic' viewBox='0 0 900 780' aria-hidden='true'>
    <defs><linearGradient id={uid+'-silver'} x1='0' y1='0' x2='.7' y2='1'><stop stop-color='#fbfaf5'/><stop offset='.17' stop-color='#545d67'/><stop offset='.35' stop-color='#d6d9db'/><stop offset='.51' stop-color='#2b333d'/><stop offset='.7' stop-color='#d7dadd'/><stop offset='1' stop-color='#69727c'/></linearGradient><linearGradient id={uid+'-seam'}><stop stop-color='#ff743b'/><stop offset='.5' stop-color='#ffe9bf'/><stop offset='1' stop-color='#b54522'/></linearGradient></defs>
    {atlasProjects.map(project=><g data-atlas-form={project.slug} transform={`translate(${project.x} ${project.y}) rotate(-12)`}>
     <g class='atlas-form-shadow' transform='translate(0 14)'>{forms[project.slug].map(d=><path d={d}/>)}</g>
     <g class='atlas-form-core'>{forms[project.slug].map(d=><><path class='atlas-form-edge' d={d}/><path d={d} stroke={'url(#'+uid+'-silver)'}/><path class='atlas-form-light' d={d}/></>)}</g>
     <path class='atlas-form-seam' d={forms[project.slug][0]} stroke={'url(#'+uid+'-seam)'}/>
    </g>)}
   </svg>
   <div class='atlas-choices' role='group' aria-label='Choose a NRTH venture'>
    {projects.map((project,i)=><a class='atlas-choice' data-atlas-choice={project.slug} data-atlas-category={project.category} data-atlas-index={i} data-index-venture={project.slug} href={'/projects/'+project.slug} style={`--atlas-x:${(150+(i%3)*300)/9}%;--atlas-y:${(120+Math.floor(i/3)*260)/7.8}%;`}><span>{project.name.replace('NRTH ','')}</span><span class='sr-only'> — open venture overview</span></a>)}
   </div>
  </div>
 </div>
 <p class='sr-only' data-atlas-status role='status'></p>
 <div class='atlas-guide-links'><p>A different field can change the question. Explore a direction here or open one of the six industry guides.</p><a class='inline-link' href='/industries'>Across the fields</a><a class='inline-link' href='/projects'>All venture overviews</a></div>
</div>
<script>import '../scripts/portfolio-atlas';</script>
