---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { projectDetails } from '../data/project-details';
import { projectArtwork } from '../data/visuals';
import Icon from './Icon.astro';
---
<div class="project-explorer" data-explorer>
  <div class="explorer-index">
    <span class="eyebrow explorer-label">Select a perspective</span>
    <div class="explorer-tabs" role="tablist" aria-label="Explore NRTH projects" aria-orientation="vertical">
      {projects.map((project, i) => <button class="explorer-tab" id={`tab-${project.slug}`} role="tab" aria-selected={i === 0} aria-controls={`panel-${project.slug}`} tabindex={i === 0 ? 0 : -1} data-project-tab={i}><span class="explorer-number">{project.number}</span><span>{project.name.replace('NRTH ', '')}</span><Icon name="upRight" /></button>)}
    </div>
    <a class="text-link explorer-all" href="/projects">All projects <Icon /></a>
  </div>
  <div class="explorer-stage">
    {projects.map((project, i) => {
      const visual = projectArtwork(project.slug);
      const details = projectDetails[project.slug];
      return <div class="explorer-panel" id={`panel-${project.slug}`} role="tabpanel" aria-labelledby={`tab-${project.slug}`} hidden={i !== 0} tabindex="0" data-project-panel>
        <a class="explorer-image" href={`/projects/${project.slug}`} aria-label={`Explore ${project.name}`}>
          <Image src={visual.src} width={1200} widths={[600, 900, 1200]} sizes="(max-width: 767px) 90vw, 68vw" format="webp" quality={82} alt={visual.alt} loading="lazy" />
          <span class="image-category">{project.category}</span><span class="image-open"><Icon name="upRight" /></span>
        </a>
        <div class="explorer-caption"><div><span class="eyebrow">{project.name}</span><h3>{project.headline}</h3></div><div><p>{details.statement}</p><a class="text-link" href={`/projects/${project.slug}`}>Discover {project.name.replace('NRTH ', '')} <Icon /></a></div></div>
        <div class="explorer-focus" aria-label="Project focus">{details.capabilities.map(item => <span>{item.title}</span>)}</div>
      </div>;
    })}
    <div class="explorer-controls"><span class="eyebrow" data-explorer-count aria-live="polite">01 / 09</span><div><button type="button" aria-label="Previous project" data-explorer-previous><Icon /></button><button type="button" aria-label="Next project" data-explorer-next><Icon /></button></div></div>
  </div>
</div>
<noscript><p class="explorer-nojs">Explore all nine projects in the <a href="/projects">project directory</a>.</p></noscript>
