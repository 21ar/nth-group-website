---
import ArtworkImage from './ArtworkImage.astro';
import {stageLabel} from '../data/projects';
import {getProjects, getProjectDetails} from '../data/content';
import { projectArtwork } from '../data/visuals';
interface Props {draft?: boolean;}
const {draft = false} = Astro.props;
const projects = await getProjects(draft);
const projectDetails: Record<string, import('../data/project-details').ProjectDetails> = Object.fromEntries(await Promise.all(projects.map(async project => [project.slug, await getProjectDetails(project.slug,draft)])));
---
<div class="project-explorer" data-explorer>
  <div class="explorer-index">
    <span class="eyebrow explorer-label">Select a perspective</span>
    <div class="explorer-tabs" role="tablist" aria-label="Explore NRTH projects" aria-orientation="vertical">
      {projects.map((project, i) => <button class="explorer-tab" id={`tab-${project.slug}`} role="tab" aria-selected={i === 0} aria-controls={`panel-${project.slug}`} tabindex={i === 0 ? 0 : -1} data-project-tab={i}><span>{project.name.replace('NRTH ', '')}</span></button>)}
    </div>
    <a class="text-link explorer-all" href="/projects">All ventures </a>
  </div>
  <div class="explorer-stage">
    {projects.map((project, i) => {
      const visual = projectArtwork(project.slug, project);
      const details = projectDetails[project.slug];
      return <div class="explorer-panel" id={`panel-${project.slug}`} role="tabpanel" aria-labelledby={`tab-${project.slug}`} hidden={i !== 0} tabindex="0" data-project-panel>
        <a class="explorer-image" href={`/projects/${project.slug}`} aria-label={`Explore ${project.name}`}>
          <ArtworkImage src={visual.src} width={1200} height={typeof visual.src === 'string' ? 800 : Math.round(1200 * visual.src.height / visual.src.width)} widths={[600, 900, 1200]} sizes="(max-width: 767px) 90vw, 68vw" format="webp" quality={82} alt={visual.alt} loading="lazy" />
          <span class="image-category">{project.category}</span>
        </a>
        <div class="explorer-caption"><div><span class="eyebrow">{project.name}</span><h3>{project.headline}</h3></div><div><p>{details.statement}</p><a class="text-link" href={`/projects/${project.slug}`}>Discover {project.name.replace('NRTH ', '')} </a></div></div>
        <div class="explorer-focus" aria-label="Venture focus"><span class="stage-badge">{stageLabel(project)}</span>{details.capabilities.slice(0,2).map(item => <span>{item.title}</span>)}</div>
      </div>;
    })}
    <div class="explorer-controls"><div><button type="button" aria-label="Previous project" data-explorer-previous>Previous</button><button type="button" aria-label="Next project" data-explorer-next>Next</button></div></div>
  </div>
</div>
<noscript><p class="explorer-nojs">Explore all nine projects in the <a href="/projects">project directory</a>.</p></noscript>
