---
import '../styles/framework-surface.css';
const labels=['Health','TMS','Telematics','Logistics','Systems','Labs','Chemicals','Fleet','Events'];
---
<figure class='framework-surface' data-framework-surface>
 <svg viewBox='0 0 900 860' role='img' aria-labelledby='framework-title framework-description'>
  <title id='framework-title'>Nine directions form a shared structure.</title><desc id='framework-description'>Nine separate silver modules gather into three open layers. The boundaries remain visible as an orange line connects the structure.</desc>
  <defs><linearGradient id='framework-silver' x1='0' y1='0' x2='1' y2='1'><stop stop-color='#4c5662'/><stop offset='.21' stop-color='#f9f7ee'/><stop offset='.42' stop-color='#77808d'/><stop offset='.53' stop-color='#252c36'/><stop offset='.76' stop-color='#dddcd6'/><stop offset='1' stop-color='#565e69'/></linearGradient><linearGradient id='framework-face'><stop stop-color='#242933'/><stop offset='1' stop-color='#0d1118'/></linearGradient><linearGradient id='framework-seam'><stop stop-color='#bc4a26'/><stop offset='.44' stop-color='#ffb174'/><stop offset='.65' stop-color='#ff743b'/><stop offset='1' stop-color='#663422'/></linearGradient></defs>
  <g class='framework-ground' fill='none' stroke='#9ea9b8' opacity='.13'><path d='M80 680L450 855L835 668M120 652L450 804L798 639M160 625L450 754L755 612'/><path d='M450 670V855M316 614L176 725M587 604L728 720'/></g>
  {labels.map((label,i)=><g data-framework-module={i} transform={`translate(${210+i%3*240} ${160+Math.floor(i/3)*255})`}>
   <path d='M0-77Q0-85 8-81L95-36Q103-32 98-25L8 25Q0 29-8 25L-98-25Q-103-32-95-36Z' fill='url(#framework-face)' stroke='url(#framework-silver)' stroke-width='9'/>
   <path d='M-100-30V43Q-100 48-95 51L-7 99Q0 103 7 99L95 51Q100 48 100 43V-30M0 26V101' fill='none' stroke='url(#framework-silver)' stroke-width='9' stroke-linejoin='round'/>
   <path class='framework-boundary' d='M-96-31L0 22L96-31' fill='none' stroke='url(#framework-seam)' stroke-width='3' pathLength='1'/>
   <circle cx='0' cy='-25' r='7' fill='#d7d9dc' opacity='.7'/><text class='framework-module-label' x='0' y='154' text-anchor='middle' fill='#d3d5d9' font-family='Manrope Variable,sans-serif' font-size='24'>{label}</text>
  </g>)}
 </svg>
 <figcaption><strong>Nine questions.<br/>A shared structure.</strong><span>The layers connect methods and responsibilities while keeping each direction distinct.</span></figcaption>
</figure>
<script>import '../scripts/framework-surface';</script>
