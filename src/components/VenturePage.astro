---
import Layout from '../layouts/Layout.astro';
import ArtworkImage from './ArtworkImage.astro';
import QualityPlate from './QualityPlate.astro';
import ContactInvitation from './ContactInvitation.astro';
import VentureStories from './VentureStories.astro';
import '../styles/venture-navigation.css';
import '../styles/venture-quality.css';
import {stageLabel,type Project} from '../data/projects';
import {getProjects,getProjectDetails} from '../data/content';
import {projectArtwork} from '../data/visuals';
import {venturePerspectives} from '../data/venture-perspectives';
interface Props {project:Project;draft?:boolean;}
const {project,draft=false}=Astro.props;
const projects=await getProjects(draft),related=projects.filter(item=>project.related.includes(item.slug)),visual=projectArtwork(project.slug,project);
const name=project.name.replace('NRTH ','');
const details=await getProjectDetails(project.slug,draft),focus=details.capabilities;
const perspective=venturePerspectives[project.slug];
---
<Layout noindex={draft} title={project.name} description={project.description}>
 {draft&&<aside class='preview-banner'><a href='/preview'>Editorial workspace</a><span data-preview-status>Draft preview</span></aside>}
 <section class='venture-heading venture-heading-quality'><div class='venture-heading-copy'><span class='section-label'>{project.category}</span><h1><span>NRTH</span>{name}</h1><h2>{project.headline}</h2><p class='venture-heading-direction'>{project.description}</p><a class='inline-link' href={'/contact?project='+project.slug}>Discuss {name}</a></div><div class='venture-heading-art'>{typeof visual.src==='string'?<ArtworkImage src={visual.src} width={1200} height={820} widths={[600,900,1200]} sizes='(max-width:767px) 100vw, 50vw' alt={visual.alt} format='webp' quality={87} loading='eager'/>:<QualityPlate kind={perspective.kind} variant={project.slug} label={perspective.graphic}/>}</div></section>
 <div class='venture-scope'><span>{stageLabel(project)}{project.reviewedAt&&<> · Reviewed <time datetime={project.reviewedAt}>{project.reviewedAt}</time></>}</span><span>A venture direction within NRTH Inc.</span>{project.productUrl&&<a class='inline-link' href={project.productUrl}>Visit the product</a>}</div>
 <nav class='venture-navigation' aria-label={project.name+' page sections'}><a href={'#'+project.slug+'-focus'}>The perspective</a><a href={'#'+project.slug+'-workflow'}>The workflow</a><a href={'#'+project.slug+'-scenario'}>In practice</a><a href={'#'+project.slug+'-questions'}>Your questions</a></nav>
 <section class='venture-overview'><div data-enter><span class='section-label'>The question behind it</span><h2>{details.statement}</h2></div><div class='venture-overview-text' data-enter><p>{project.introduction}</p><p>{perspective.lens}</p><div class='venture-audience'><h3>Perspectives to bring together</h3><ul>{details.audience.map(audience=><li>{audience}</li>)}</ul></div></div></section>
 <section class='venture-focus' id={project.slug+'-focus'} data-focus-explorer><div class='section-heading' data-enter><h2>Take a<br/><em>closer look.</em></h2><p>Choose a perspective. See the context it needs, what could be clarified and the question that should guide a review.</p></div><div class='focus-layout'><div class='focus-choices' hidden role='tablist' aria-label={name+' areas of focus'} aria-orientation='vertical'>{focus.map((focus,i)=><button id={'focus-tab-'+i} type='button' role='tab' aria-controls={'focus-panel-'+i} aria-selected={i===0} tabindex={i===0?0:-1} data-focus-choice>{focus.title}</button>)}</div><div class='focus-description'>{focus.map((focus,i)=><div id={'focus-panel-'+i} role='tabpanel' aria-labelledby={'focus-tab-'+i} data-focus-panel hidden={i!==0}><h3>{focus.title}</h3><p>{focus.text}</p><dl class='venture-focus-evidence'><div><dt>Bring the context</dt><dd>{perspective.focus[i].bring}</dd></div><div><dt>Make it concrete</dt><dd>{perspective.focus[i].shape}</dd></div><div><dt>Review the question</dt><dd>{perspective.focus[i].review}</dd></div></dl><a class='inline-link' href={'/contact?project='+project.slug+'&topic='+encodeURIComponent(focus.title)}>Start with this question</a></div>)}</div></div><noscript><div class='text-stack'>{focus.slice(1).map((focus,i)=><article><h3>{focus.title}</h3><p>{focus.text}</p><dl class='venture-focus-evidence'><div><dt>Bring the context</dt><dd>{perspective.focus[i+1].bring}</dd></div><div><dt>Make it concrete</dt><dd>{perspective.focus[i+1].shape}</dd></div><div><dt>Review the question</dt><dd>{perspective.focus[i+1].review}</dd></div></dl></article>)}</div></noscript></section>
 <VentureStories slug={project.slug}/>
 <section class='editorial-split section-dark venture-connections'><div data-enter><span class='section-label'>The connections</span><h2>There is more<br/>around the idea.</h2><p>{details.connection}</p><a class='inline-link' href={'/industries/'+perspective.kind}>Explore the {project.category.toLowerCase()} perspective</a></div><div class='related-links' data-enter>{related.map(item=><a href={'/projects/'+item.slug}><strong>{item.name}</strong><span class='venture-relation-category'>{item.category}</span><p>{perspective.related[item.slug]||item.description}</p></a>)}</div></section>
 <section class='venture-preparation'><div class='section-heading' data-enter><h2>Bring the<br/><em>real context.</em></h2><p>A first conversation becomes more useful when the work, the uncertainty and the next decision are specific.</p></div><div class='venture-preparation-grid'>{details.journey.map(item=><article data-enter><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class='venture-preparation-next'><p>Current scope, availability, commercial terms and specific capabilities are established directly with NRTH. This introduction describes a direction.</p><a class='inline-link' href='/projects'>Explore another venture</a>{project.demoUrl&&<a class='inline-link' href={project.demoUrl}>View the approved demo</a>}</div></section>
 <ContactInvitation project={project.slug} headline={'Let’s talk '+name+'.'}/>
</Layout>
