---
import type {IndustryExhibit} from '../data/industry-exhibits';
import '../styles/evidence-exhibits.css';
interface Props {exhibit:IndustryExhibit; compact?:boolean;}
const {exhibit,compact=false}=Astro.props;
const uid='exhibit-'+exhibit.id+'-'+crypto.randomUUID().slice(0,8);
const positions:Record<IndustryExhibit['model'],[number,number][]>= {
 route:[[68,166],[234,72],[400,210],[566,122]],
 access:[[68,166],[234,100],[400,100],[566,166]],
 contract:[[68,166],[234,166],[400,166],[566,166]],
 conditions:[[68,166],[234,70],[400,214],[566,166]],
 rhythm:[[68,205],[234,70],[400,145],[566,205]],
 question:[[68,166],[234,80],[400,80],[566,166]],
};
const points=positions[exhibit.model];
const paths=points.slice(0,3).map((p,i)=>{const q=points[i+1];return `M${p[0]} ${p[1]} C${p[0]+65} ${p[1]} ${q[0]-65} ${q[1]} ${q[0]} ${q[1]}`;});
---
<section class:list={['evidence-exhibit',{'is-compact':compact}]} data-evidence-exhibit data-exhibit-id={exhibit.id} data-exhibit-model={exhibit.model} aria-labelledby={uid+'-title'}>
 <div class='evidence-exhibit-heading'><span class='section-label'>An illustrative example</span><h3 id={uid+'-title'}>{exhibit.title}</h3><p>{exhibit.question}</p></div>
 <fieldset class='evidence-exhibit-controls'><legend>Compare the context</legend>{exhibit.snapshots.map((snapshot,index)=><Fragment><input class='evidence-case-input' type='radio' id={uid+'-case-'+index} name={uid} checked={index===0} value={String(index)} data-exhibit-case={snapshot.label}/><label for={uid+'-case-'+index}>{snapshot.label}</label></Fragment>)}</fieldset>
 {exhibit.snapshots.map((snapshot,index)=><div class={'evidence-case evidence-case-'+index}>
  <figure class={'evidence-exhibit-figure evidence-model-'+exhibit.model}>
   <svg viewBox='0 0 634 290' role='img' aria-labelledby={uid+'-graphic-'+index+' '+uid+'-description-'+index}>
    <title id={uid+'-graphic-'+index}>{snapshot.label}: {exhibit.title}</title><desc id={uid+'-description-'+index}>{exhibit.labels.map((label,i)=>label+': '+snapshot.values[i]).join('. ')}. Orange connections have context in place; broken grey connections remain unresolved.</desc>
    <defs><linearGradient id={uid+'-chrome-'+index} x1='0' y1='0' x2='0.8' y2='1'><stop offset='0' stop-color='#fffdf5'/><stop offset='.25' stop-color='#757980'/><stop offset='.5' stop-color='#e3e4e0'/><stop offset='.8' stop-color='#5b6069'/><stop offset='1' stop-color='#f9f6ed'/></linearGradient></defs>
    {exhibit.model==='access'&&<g class='evidence-geometry'><ellipse cx='316' cy='145' rx='224' ry='115'/><ellipse cx='316' cy='145' rx='164' ry='85'/></g>}
    {exhibit.model==='contract'&&<g class='evidence-geometry'><path d='M157 42 V250 M317 42 V250 M477 42 V250'/><rect x='188' y='99' width='251' height='133' rx='14'/></g>}
    {exhibit.model==='conditions'&&<g class='evidence-geometry'><path d='M316 20 L469 107 L469 224 L316 283 L164 224 L164 107 Z M316 20 V283 M164 107 L469 224 M469 107 L164 224'/></g>}
    {exhibit.model==='rhythm'&&<g class='evidence-geometry evidence-spectrum'>{[104,139,174,209,244,279,314,349,384,419,454,489,524].map((x,i)=><path d={`M${x} ${115+Math.abs(i-6)*8} V${215-Math.abs(i-6)*8}`}/>)}</g>}
    {exhibit.model==='question'&&<g class='evidence-geometry'><path d='M234 80 C234 25 282 18 315 18 M400 80 C447 38 482 45 502 45 M400 80 C443 139 460 189 480 222 M234 80 C234 188 170 220 142 247'/></g>}
    {exhibit.model==='route'&&<g class='evidence-geometry'><path d='M40 245 C130 245 144 34 253 34 C374 34 338 261 467 261 C554 261 566 74 604 74'/></g>}
    {paths.map((d,i)=><path d={d} class:list={['evidence-link',{'is-resolved':snapshot.active[i]}]}/>)}
    {points.map((p,i)=><g class='evidence-node' style={`--evidence-node-index:${i}`}><circle cx={p[0]} cy={p[1]} r='21' fill={'url(#'+uid+'-chrome-'+index+')'}/><circle cx={p[0]} cy={p[1]} r='6' fill={i===0||snapshot.active[i-1]?'#ff7844':'#3b3e43'}/></g>)}
   </svg>
   <figcaption class='evidence-values'>{exhibit.labels.map((label,i)=><div><span>{label}</span><strong>{snapshot.values[i]}</strong></div>)}</figcaption>
  </figure>
  <div class='evidence-exhibit-observation'><h4>What changes</h4><p>{snapshot.observation}</p></div>
  <details class='evidence-exhibit-review'><summary>The tradeoff and review</summary><div><h4>The tradeoff</h4><p>{snapshot.tradeoff}</p><h4>A useful review</h4><p>{snapshot.review}</p></div></details>
 </div>)}
 <p class='evidence-exhibit-scope'>A synthetic information model. The states show design choices and unresolved responsibilities, rather than a live product, validated outcome or operational recommendation.</p>
</section>

<script>import '../scripts/work-library';</script>
