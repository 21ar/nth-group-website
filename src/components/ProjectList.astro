---
import ArtworkImage from './ArtworkImage.astro';
import {categories, stageLabel} from '../data/projects';
import {getProjects} from '../data/content';
import { projectArtwork } from '../data/visuals';
import { projectDetails } from '../data/project-details';
const { filters = false } = Astro.props;
const projects = await getProjects();
---
<div class="project-directory visual-directory" data-project-directory data-directory-view="grid">
  {filters && <div class="directory-tools">
    <div class="filters" role="group" aria-label="Filter projects by field">{categories.map((category, i) => <button type="button" data-filter={category} aria-pressed={i === 0}>{category}</button>)}</div>
    <div class="directory-utilities"><label class="project-search"><span class="sr-only">Search projects</span><input type="search" placeholder="Find a project" data-project-search /></label><div class="directory-view" role="group" aria-label="Project display"><button type="button" data-view="grid" aria-pressed="true">Grid</button><button type="button" data-view="list" aria-pressed="false">List</button></div></div>
  </div>}
  <div class="project-rows">
    {projects.map(project => {
      const visual = projectArtwork(project.slug, project);
      return <a class="project-row project-card" href={`/projects/${project.slug}`} data-project-category={project.category} data-project-name={`${project.name} ${project.description}`}>
        <div class="project-card-image"><ArtworkImage src={visual.src} width={800} height={typeof visual.src === 'string' ? 533 : Math.round(800 * visual.src.height / visual.src.width)} widths={[400, 600, 800]} sizes="(max-width: 767px) 90vw, (max-width: 1100px) 44vw, 29vw" alt={visual.alt} format="webp" quality={80} loading="lazy" /></div>
        <div class="project-card-meta"><span class="project-category">{project.category}</span></div>
        <span class="project-name">{project.name}</span><span class="project-description">{projectDetails[project.slug].statement}</span>
        <span class="project-card-tags"><span>{stageLabel(project)}</span><span>{projectDetails[project.slug].capabilities[0].title}</span></span>
      </a>;
    })}
  </div>
  {filters && <p class="filter-result" role="status" aria-live="polite" data-project-count>9 projects</p>}
  <p class="empty-state" data-project-empty hidden>No projects match. Try another field or search.</p>
</div>
