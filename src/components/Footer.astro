---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { projects } from '../data/projects';
---
<footer class="site-footer">
  <div class="footer-top">
    <Logo footer />
    <a class="footer-contact" href="/contact">Let’s find a new direction. <Icon name="upRight" /></a>
  </div>
  <div class="footer-links">
    <div><span class="eyebrow">The company</span><a href="/about">About NRTH</a><a href="/approach">Our approach</a><a href="/insights">Insights</a><a href="/investors">Investors</a><a href="/contact">Contact</a></div>
    <div class="footer-projects"><span class="eyebrow">Our projects</span>{projects.map(project => <a href={`/projects/${project.slug}`}>{project.name}</a>)}</div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} NRTH Inc.</span><span>Different fields. Shared ambition.</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a><button type="button" data-motion-toggle aria-pressed="false">Pause motion</button></div></div>
</footer>
