---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props {src: string | ImageMetadata; alt: string; width: number; height?: number; widths?: number[]; sizes?: string; format?: 'webp' | 'png'; quality?: number; loading?: 'eager' | 'lazy'; fetchpriority?: 'high' | 'low' | 'auto';}
const {src, ...props} = Astro.props;
---
{typeof src === 'string' ? <Image src={src} {...props} height={props.height || Math.round(props.width * 2/3)} /> : <Image src={src} {...props} />}
