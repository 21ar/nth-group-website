---
import Logo from './Logo.astro';
import {projects} from '../data/projects';
const path = Astro.url.pathname;
---
<header class="site-header">
  <Logo />
  <div class='header-words'><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Inside NRTH</button><noscript><a href='/projects'>Ventures</a></noscript><a class="header-contact" href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Let’s talk</a></div>
</header>
<nav id="mobile-navigation" class="mobile-navigation" aria-label="Inside NRTH" hidden>
  <div class='menu-company'><a href="/projects">Ventures</a><a href="/about">Company</a><a href="/research">Research</a><a href="/insights">Journal</a><a href="/investors">Investors</a></div>
  <div class='menu-ventures'><span>Explore a venture</span>{projects.map(project=><a href={'/projects/'+project.slug}>{project.name}</a>)}</div>
  <div class='menu-secondary'><a href='/approach'>Our approach</a><a href='/partnerships'>Partnerships</a><a href='/press'>Press resources</a><a href='/contact'>Contact</a></div>
</nav>
