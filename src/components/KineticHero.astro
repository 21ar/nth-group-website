---
import HeroScene from './HeroScene.astro';
import Icon from './Icon.astro';
import { industries } from '../data/industries';
import { siteContent } from '../data/site-content';
const chapters = [
 siteContent.opening,
 {label:'01 / A shared foundation', lines:['Different fields.','One shared thread.'], copy:'Independent ideas find common ground. Four forms become a shared language.'},
 {label:'02 / Connected by possibility', lines:['No idea exists','in isolation.'], copy:'Care connects to movement. Movement connects to systems. Each field opens a new perspective.'},
 ...industries.map((industry,i)=>({label:`${String(i+3).padStart(2,'0')} / ${industry.name}`, lines:industry.title, copy:industry.copy})),
 {label:'09 / The next connection', lines:['What could','we shape next?'], copy:'Start with a question. Find a perspective. Make the next connection.'}
];
---
<section class="kinetic-story brand-story" data-story aria-label="NRTH: ideas become connections">
 <div class="story-viewport home-hero" data-story-viewport>
  <div class="story-surface" aria-hidden="true"></div>
  <HeroScene />
  <a class="story-kicker eyebrow" href="/about">NRTH Inc. / A world of connections</a>
  {chapters.map((chapter,i)=><div class:list={['story-chapter',i===0?'story-opening hero-statement':'brand-chapter']} data-story-chapter={i} aria-hidden={i>0?'true':undefined} inert={i>0}>
   <span class="eyebrow">{chapter.label}</span>
   {i===0?<h1 id="hero-heading">{chapter.lines.map(line=><span>{line}</span>)}</h1>:<h2>{chapter.lines.map(line=><span>{line}</span>)}</h2>}
   <p>{chapter.copy}</p>
   {i===9?<a class="text-link" href="/contact" data-magnetic>Start a conversation <Icon /></a>:i>=3?<div class="industry-ventures">{industries[i-3].ventures.map(name=><a href={`/projects/nrth-${name.toLowerCase()}`}><span class="ring-bullet" aria-hidden="true"></span>NRTH {name}<Icon name="upRight" /></a>)}</div>:null}
  </div>)}
  <div class="brand-aside"><span class="eyebrow">Independent ideas.<br />Shared ambition.</span><p>One thread.<br />Many possibilities.</p></div>
  <nav class="industry-nav" aria-label="Explore industries">{industries.map((industry,i)=><button type="button" data-industry={i} aria-label={`Explore ${industry.name}`}><span class="nav-ring" aria-hidden="true"></span>{industry.name}</button>)}</nav>
  <div class="shape-caption" aria-hidden="true"><span data-shape-number>01</span><span data-shape-name>Identity / N–R–T–H</span></div>
  <div class="hero-bottom story-bottom"><a class="hero-chapter" href="/projects"><span>09</span> ventures. One shared ambition.</a><div class="story-scroll"><span data-story-label>Scroll to discover</span><span class="story-progress" aria-hidden="true"><span data-story-progress></span></span></div><button type="button" data-motion-toggle aria-pressed="false">Pause motion</button></div>
 </div>
</section>
