---
import HeroScene from './HeroScene.astro';
import Icon from './Icon.astro';
import {getSiteContent, getIndustries} from '../data/content';
interface Props {draft?: boolean;}
const {draft = false} = Astro.props;
const siteContent = await getSiteContent(draft);
const industries = await getIndustries(draft);
const chapters = [
  siteContent.opening,
  {label: '01 / A shared foundation', lines: ['Independent ventures.', 'Shared ambition.'], copy: 'Nine directions. A common instinct to make the next connection useful.'},
  {label: '02 / Connected by possibility', lines: ['The space between', 'is where it begins.'], copy: 'Care, movement, technology, materials, experiences, and research. Each brings a different perspective.'},
  ...industries.map((industry, i) => ({label: String(i + 3).padStart(2, '0') + ' / ' + industry.name, lines: industry.title, copy: industry.copy})),
  {label: '09 / The portfolio', lines: ['Find your', 'next connection.'], copy: 'Explore the ventures, try a concept, or bring a question of your own.'},
];
---
<section class='kinetic-story brand-story' data-story aria-label='NRTH: independent ventures, shared ambition'>
  <div class='story-viewport' data-story-viewport>
    <div class='story-surface' aria-hidden='true'></div>
    <HeroScene />
    <span class='story-kicker eyebrow'>NRTH Inc. / Independent by design</span>
    {chapters.map((chapter, i) => <div class:list={['story-chapter', i === 0 ? 'story-opening hero-statement is-current' : 'brand-chapter']} data-story-chapter={i} aria-hidden={i > 0 ? 'true' : undefined} inert={i > 0}>
      <span class='eyebrow'>{chapter.label}</span>
      {i === 0 ? <h1 id='hero-heading'>{chapter.lines.map(line => <span>{line}</span>)}</h1> : <h2>{chapter.lines.map(line => <span>{line}</span>)}</h2>}
      <p>{chapter.copy}</p>
      {i >= 3 && i < 9 ? <div class='industry-ventures'>{industries[i - 3].ventures.map(name => <a href={'/projects/nrth-' + name.toLowerCase()}><span class='ring-bullet' aria-hidden='true'></span>NRTH {name}<Icon name='upRight' /></a>)}</div> : i === 9 ? <a class='text-link' href='#ecosystem'>Meet the ventures <Icon name='down' /></a> : null}
    </div>)}
    <nav class='industry-nav' aria-label='Explore industries'>{industries.map((industry, i) => <button type='button' data-industry={i} aria-label={'Explore ' + industry.name}><span class='nav-ring' aria-hidden='true'></span>{industry.name}</button>)}</nav>
    <div class='shape-caption' aria-hidden='true'><span data-shape-number>01</span><span data-shape-name>Identity / N–R–T–H</span></div>
    <div class='hero-bottom story-bottom'><a class='hero-chapter' href='/projects'><span>09</span><span>ventures.<br />One shared ambition.</span><Icon name='upRight' /></a><div class='story-scroll'><span data-story-label>Scroll to discover</span><span class='story-progress' aria-hidden='true'><span data-story-progress></span></span></div><button type='button' data-motion-toggle aria-pressed='false'>Pause motion</button></div>
  </div>
</section>
