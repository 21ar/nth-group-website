# Browser-visible fallback addresses. Provision these inboxes/aliases separately.
PUBLIC_CONTACT_EMAIL=hello@nrth.group
PUBLIC_PARTNERSHIPS_EMAIL=partnerships@nrth.group
PUBLIC_INVESTORS_EMAIL=investors@nrth.group
PUBLIC_ENABLE_ANALYTICS=false

# Server-only direct delivery. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_EMAIL=hello@nrth.group
PARTNERSHIPS_EMAIL=partnerships@nrth.group
INVESTORS_EMAIL=investors@nrth.group

# Optional server/build CMS connection. Leave unset to use repository content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
CMS_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=
# Write token is only for the local draft initialization script, not the website.
SANITY_API_WRITE_TOKEN=
