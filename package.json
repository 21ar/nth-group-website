{
  "name": "nrth-group-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-resources.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/build-resources.mjs && NRTH_CONTENT_SNAPSHOT=.astro/published-content.json ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/preview.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:geometry": "node verify-matter.cjs",
    "test:services": "node verify-services.mjs",
    "test:browser": "node verify-browser.cjs",
    "test:enrichment": "node verify-enrichment.cjs",
    "test:depth": "node verify-depth.cjs",
    "test:baseline": "node scripts/verify-baseline.cjs",
    "test:ventures": "node scripts/verify-venture-experiences.cjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/core": "^2.1.1",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.16.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.2"
  }
}
